      <h3>শেষ ধাপ — অ্যাকাউন্ট তৈরি করুন</h3>
      <div class="aw-sub">আপনার অর্ডারটি সম্পন্ন করতে একটি অ্যাকাউন্ট তৈরি করুন।</div>
      <div class="aw-benefits">
        <div class="aw-benefit"><span class="aw-ic">📦</span><div class="aw-txt"><b>লাইভ অর্ডার ট্র্যাকিং</b><small>অর্ডার কোথায় আছে জানুন</small></div></div>
        <div class="aw-benefit"><span class="aw-ic">💬</span><div class="aw-txt"><b>সরাসরি সাপোর্ট</b><small>দ্রুত সাহায্য পাবেন</small></div></div>
        <div class="aw-benefit"><span class="aw-ic">⭐</span><div class="aw-txt"><b>অর্ডার হিস্টোরি</b><small>সব অর্ডার সেভ থাকবে</small></div></div>
      </div>
    </div>
  ` : '';

  const body = `
