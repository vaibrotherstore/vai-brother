    <div class="notice" style="margin-top:16px"><span class="n-ico">${ICO.lock}</span><span>আপনার তথ্য এনক্রিপ্টেড ও সুরক্ষিত।</span></div>`;

  openSheet(isLogin?'লগইন':'নতুন অ্যাকাউন্ট', body);
}
window.openAuthSheet = openAuthSheet;

