let fuseIndex = null;
function rebuildFuseIndex() {
  if (typeof Fuse === 'undefined') return;
  fuseIndex = new Fuse(ALL_PRODUCTS, {
    keys: [
      { name: 'name', weight: 0.5 },
      { name: 'brand', weight: 0.2 },
      { name: 'category', weight: 0.15 },
      { name: 'description', weight: 0.1 },
      { name: 'sku', weight: 0.05 }
    ],
    threshold: 0.45,
    distance: 100,
    includeScore: true,
    ignoreLocation: true,
    minMatchCharLength: 2
  });
}

function expandSearchTerms(query) {
  const q = String(query || '').toLowerCase().trim();
  if (!q) return [];
  const terms = new Set([q]);
  for (const [bn, ens] of Object.entries(BN_EN_MAP)) {
    if (q.includes(bn.toLowerCase())) {
      ens.forEach(en => terms.add(en));
      ens.forEach(en => terms.add(q.replace(bn.toLowerCase(), en)));
    }
    for (const en of ens) {
      if (q.includes(en)) {
        terms.add(bn);
        terms.add(q.replace(en, bn));
      }
    }
  }
  q.split(/\s+/).forEach(w => { if (w.length >= 2) terms.add(w); });
  return [...terms].filter(Boolean);
}

function smartSearchProducts(query, opts = {}) {
  let list = [];
  const rawQ = (query || '').trim();

  if (!rawQ) list = [...ALL_PRODUCTS];
  else if (fuseIndex) {
    const resultsMap = new Map();
    const expanded = expandSearchTerms(rawQ);
    expanded.forEach(term => {
      try {
        fuseIndex.search(term).forEach(r => {
          const id = r.item.id;
          const score = r.score || 0.5;
          if (!resultsMap.has(id) || resultsMap.get(id) > score) resultsMap.set(id, score);
        });
      } catch(e){}
    });
    const q = rawQ.toLowerCase();
    ALL_PRODUCTS.forEach(p => {
      const hay = [p.name, p.brand, p.category, p.sku, p.description].filter(Boolean).join(' ').toLowerCase();
      if (expanded.some(t => hay.includes(t.toLowerCase()))) {
        if (!resultsMap.has(p.id)) resultsMap.set(p.id, 0.6);
      }
    });
    list = [...resultsMap.entries()]
      .sort((a, b) => a[1] - b[1])
      .map(([id]) => ALL_PRODUCTS.find(p => p.id === id))
      .filter(Boolean);
  } else {
    const expanded = expandSearchTerms(rawQ);
    list = ALL_PRODUCTS.filter(p => {
      const hay = [p.name, p.brand, p.category, p.sku].filter(Boolean).join(' ').toLowerCase();
      return expanded.some(t => hay.includes(t.toLowerCase()));
    });
  }

  if (opts.category && opts.category !== 'all') {
    const cat = getCategory(opts.category);
    const catName = cat ? cat.name.toLowerCase() : opts.category.toLowerCase();
    const catId = cat ? cat.id.toLowerCase() : opts.category.toLowerCase();
    list = list.filter(p => 
        (p.category && p.category.toLowerCase() === catName) || 
        (p.category && p.category.toLowerCase() === catId)
    );
  }
  if (opts.brand && opts.brand.length) list = list.filter(p => opts.brand.includes(p.brand));
  if (opts.minPrice != null) list = list.filter(p => p.price >= opts.minPrice);
  if (opts.maxPrice != null) list = list.filter(p => p.price <= opts.maxPrice);
  if (opts.rating) list = list.filter(p => p.rating >= opts.rating);
  if (opts.inStock) list = list.filter(p => (Number(p.stock) || 0) > 0);

  const sort = opts.sort || 'popular';
  const sorters = {
    popular: (a,b) => (b.sold||0) - (a.sold||0),
    newest: (a,b) => (b.createdAt||0) - (a.createdAt||0) || String(b.id).localeCompare(String(a.id)),
    priceLow: (a,b) => a.price - b.price,
    priceHigh: (a,b) => b.price - a.price,
    rating: (a,b) => (b.rating||0) - (a.rating||0),
    discount: (a,b) => (1 - b.price/(b.mrp||b.price)) - (1 - a.price/(a.mrp||a.price))
  };
  list.sort(sorters[sort] || sorters.popular);
  return list;
}

/* ==========================================================================
   🌐 IN-APP BROWSER DETECTOR
   ========================================================================== */
const InAppBrowser = {
  isInApp(){
    const ua = navigator.userAgent || '';
    return /FBAN|FBAV|FB_IAB|Instagram|Line\/|TikTok|BytedanceWebview|Twitter|LinkedIn|Snapchat|Pinterest|WeChat|MicroMessenger/i.test(ua);
  },
  name(){
    const ua = navigator.userAgent || '';
    if (/FBAN|FBAV|FB_IAB/i.test(ua)) return 'Facebook';
    if (/Instagram/i.test(ua)) return 'Instagram';
    if (/TikTok|BytedanceWebview/i.test(ua)) return 'TikTok';
    if (/Line\//i.test(ua)) return 'LINE';
    if (/Twitter/i.test(ua)) return 'Twitter';
    if (/LinkedIn/i.test(ua)) return 'LinkedIn';
    if (/Snapchat/i.test(ua)) return 'Snapchat';
    if (/Pinterest/i.test(ua)) return 'Pinterest';
    if (/MicroMessenger|WeChat/i.test(ua)) return 'WeChat';
    return 'App';
  },
  isAndroid(){ return /Android/i.test(navigator.userAgent); },
  isIOS(){ return /iPhone|iPad|iPod/i.test(navigator.userAgent); }
};

