   🔐 AUTH
   ========================================================================== */
function openAuthSheet(mode='login', context=''){
  const isLogin = mode === 'login';
  const isOrderContext = context === 'order';

  const authWallBanner = isOrderContext ? `
    <div class="auth-wall-card">
