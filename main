/* ==========================================================================
   🧩 PRODUCT CARD
   ========================================================================== */
function productCard(p){
  const off = p.mrp ? Math.round((1 - p.price/p.mrp) * 100) : 0;
  const wished = S.wishlist.includes(p.id);
  const out = p.stock <= 0;
  const imgUrl = getProductImage(p);
  const vid = getProductVideo(p);
  const thumb = imgUrl
    ? `<img src="${imgUrl}" alt="${escAttr(p.name)}" loading="lazy" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='block'"><span class="pcard-emoji" style="display:none">${p.emoji||'📦'}</span>`
    : `<span class="pcard-emoji">${p.emoji||'📦'}</span>`;
  return `
  <article class="p-card" data-id="${escAttr(p.id)}">
    <div class="p-thumb" data-action="open-product">
      ${thumb}
      ${vid ? `<span class="badge-tag" style="background:rgba(0,0,0,.7);right:7px;left:auto;top:auto;bottom:7px">${ICO.video} ভিডিও</span>` : ''}
      ${off > 0 ? `<span class="badge-off">-${bn(off)}%</span>` : ''}
      ${out ? `<span class="badge-tag" style="background:var(--danger)">স্টক শেষ</span>` : ''}
      <button class="wish-btn ${wished?'active':''}" data-action="toggle-wish" data-id="${escAttr(p.id)}" aria-label="উইশলিস্ট">${ICO.heart}</button>
    </div>
    <div class="p-body">
      <div class="p-name" data-action="open-product">${esc(p.name)}</div>
      <div class="p-price" data-action="open-product">
        <span class="now">${money(p.price)}</span>
        ${p.mrp > p.price ? `<s>${money(p.mrp)}</s>` : ''}
      </div>
      <div class="p-meta" data-action="open-product">
        <span class="star">${ICO.star} ${bn(p.rating||4.5)}</span>
        <span>(${bn(p.reviewsCount||0)})</span>
        <span class="dot">·</span>
        <span>${bn(p.sold||0)}+ বিক্রি</span>
      </div>
      <button class="p-cart-btn" ${out?'disabled':''} data-action="add-to-cart" data-id="${escAttr(p.id)}">
        ${out ? 'স্টক নেই' : ICO.cart + '<span>কার্টে যোগ</span>'}
      </button>
    </div>
  </article>`;
}

document.addEventListener('click', e => {
  const el = e.target.closest('[data-action]');
  if (!el) return;
  const action = el.dataset.action;
  const id = el.dataset.id;
  if (action === 'open-product'){
    const card = el.closest('.p-card');
    if (card && card.dataset.id) go('/product/' + card.dataset.id);
  } else if (action === 'toggle-wish'){
    e.stopPropagation();
    if (id) toggleWish(id);
  } else if (action === 'add-to-cart'){
    e.stopPropagation();
    if (id) addToCart(id, 1);
  }
});

/* ==========================================================================
   🗂️ CATEGORY PAGE
   ========================================================================== */
let filterState = { sort:'popular', minPrice:null, maxPrice:null, brand:[], rating:null };
let lastCategoryId = null;

function renderCategory(catId){
  if (lastCategoryId !== catId){
    filterState = { sort:'popular', minPrice:null, maxPrice:null, brand:[], rating:null };
    lastCategoryId = catId;
  }
  const cat = getCategory(catId);
  const title = cat ? cat.name : 'সব পণ্য';
  const list = smartSearchProducts('', { category: catId, ...filterState });
  const activeFilters = [
    filterState.brand.length ? `${filterState.brand.length} ব্র্যান্ড` : '',
    filterState.minPrice != null || filterState.maxPrice != null ? 'প্রাইস' : '',
    filterState.rating ? `${filterState.rating}★+` : ''
  ].filter(Boolean);

  const sortOptions = [
    { key:'popular', label:'জনপ্রিয়' },
    { key:'priceLow', label:'দাম ↑' },
    { key:'priceHigh', label:'দাম ↓' },
    { key:'rating', label:'রেটিং' },
    { key:'discount', label:'সর্বোচ্চ ছাড়' }
  ];

  return `
  <div style="display:flex;align-items:center;gap:10px;padding:14px 2px 10px">
    <button class="icon-btn" style="width:36px;height:36px;flex:0 0 36px" onclick="history.back()">${ICO.arrowL}</button>
    <h1 style="font-size:17px;font-weight:700">${esc(title)}</h1>
    <span style="margin-left:auto;font-size:12.5px;color:var(--muted)" id="catCount">${bn(list.length)} টি পণ্য</span>
  </div>

  <div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:12px" class="noscroll">
    <button class="cat-chip" style="background:${activeFilters.length?'var(--primary)':'#fff'};color:${activeFilters.length?'#fff':'var(--text)'}" data-cat="${escAttr(catId)}" onclick="openFilterSheet(this.dataset.cat)">⚙️ ফিল্টার${activeFilters.length ? ' •'+activeFilters.length : ''}</button>
    ${sortOptions.map(o => `
      <button class="cat-chip sort-chip ${filterState.sort===o.key?'active':''}" data-sort="${o.key}" data-cat="${escAttr(catId)}" onclick="setSort(this.dataset.sort, this.dataset.cat)">${esc(o.label)}</button>
    `).join('')}
  </div>

  <div id="catGrid">${list.length
    ? `<div class="p-grid">${list.map(productCard).join('')}</div>`
    : `<div class="empty-state"><div class="es-ico">${ICO.search}</div><h3>কোনো পণ্য পাওয়া যায়নি</h3><p>ফিল্টার পরিবর্তন করে চেষ্টা করুন</p><button class="btn btn-primary" onclick="resetFilters()">ফিল্টার রিসেট</button></div>`}</div>
  ${siteFooter()}`;
}

function setSort(s, catId){
  if (filterState.sort === s) return;
  filterState.sort = s;
  $$('.sort-chip').forEach(c => c.classList.toggle('active', c.dataset.sort === s));
  const grid = $('#catGrid');
  if (!grid) return;
  grid.style.opacity = '0';
  setTimeout(()=>{
    const list = smartSearchProducts('', { category: catId, ...filterState });
    grid.innerHTML = list.length
      ? `<div class="p-grid">${list.map(productCard).join('')}</div>`
      : `<div class="empty-state"><div class="es-ico">${ICO.search}</div><h3>কোনো পণ্য পাওয়া যায়নি</h3><p>ফিল্টার পরিবর্তন করে চেষ্টা করুন</p><button class="btn btn-primary" onclick="resetFilters()">ফিল্টার রিসেট</button></div>`;
    const cc = $('#catCount');
    if (cc) cc.textContent = bn(list.length) + ' টি পণ্য';
    grid.style.opacity = '1';
    try { window.scrollTo({ top: 0, behavior: 'smooth' }); } catch(e){ window.scrollTo(0, 0); }
  }, 160);
}
function resetFilters(){ filterState = { sort:'popular', minPrice:null, maxPrice:null, brand:[], rating:null }; render(); }
window.setSort = setSort; window.resetFilters = resetFilters;

function openFilterSheet(catId){
  const catProducts = (catId && catId !== 'all') ? smartSearchProducts('', { category: catId }) : ALL_PRODUCTS;
  const brands = [...new Set(catProducts.map(p => p.brand).filter(Boolean))];
  const body = `
    <div class="field">
      <label>দামের সীমা (৳)</label>
      <div class="row-2">
        <input class="input" type="number" id="fMin" placeholder="সর্বনিম্ন" value="${filterState.minPrice ?? ''}">
        <input class="input" type="number" id="fMax" placeholder="সর্বোচ্চ" value="${filterState.maxPrice ?? ''}">
      </div>
    </div>
    ${brands.length ? `<div class="field">
      <label>ব্র্যান্ড</label>
      ${brands.map(b => `<label class="check"><input type="checkbox" class="fBrand" value="${escAttr(b)}" ${filterState.brand.includes(b)?'checked':''}><span>${esc(b)}</span></label>`).join('')}
    </div>` : ''}
    <div class="field">
      <label>রেটিং</label>
      ${[4,3,2].map(r => `<label class="check"><input type="radio" name="fRating" value="${r}" ${filterState.rating===r?'checked':''}><span>${'★'.repeat(r)}${'☆'.repeat(5-r)} ও উপরে</span></label>`).join('')}
    </div>`;
  const foot = `<div style="display:flex;gap:10px"><button class="btn btn-ghost" style="flex:1" onclick="resetFilters();closeSheet()">রিসেট</button><button class="btn btn-primary" style="flex:2" onclick="applyFilters()">প্রয়োগ করুন</button></div>`;
  openSheet('ফিল্টার', body, foot);
}
window.openFilterSheet = openFilterSheet;

function applyFilters(){
  filterState.minPrice = $('#fMin').value === '' ? null : Number($('#fMin').value);
  filterState.maxPrice = $('#fMax').value === '' ? null : Number($('#fMax').value);
  filterState.brand = $$('.fBrand:checked').map(c => c.value);
  const r = $('input[name="fRating"]:checked');
  filterState.rating = r ? Number(r.value) : null;
  closeSheet();
  
  const { parts } = parseHash();
  const catId = parts[1] || 'all';
  const list = smartSearchProducts('', { category: catId, ...filterState });
  const grid = $('#catGrid');
  if (grid) {
    grid.innerHTML = list.length
      ? `<div class="p-grid">${list.map(productCard).join('')}</div>`
      : `<div class="empty-state"><div class="es-ico">${ICO.search}</div><h3>কোনো পণ্য পাওয়া যায়নি</h3><p>ফিল্টার পরিবর্তন করে চেষ্টা করুন</p><button class="btn btn-primary" onclick="resetFilters()">ফিল্টার রিসেট</button></div>`;
    const cc = $('#catCount');
    if (cc) cc.textContent = bn(list.length) + ' টি পণ্য';
    
    const activeFilters = [
      filterState.brand.length ? `${filterState.brand.length} ব্র্যান্ড` : '',
      filterState.minPrice != null || filterState.maxPrice != null ? 'প্রাইস' : '',
      filterState.rating ? `${filterState.rating}★+` : ''
    ].filter(Boolean);
    const filterBtn = document.querySelector('button[onclick*="openFilterSheet"]');
    if (filterBtn) {
      filterBtn.style.background = activeFilters.length ? 'var(--primary)' : '#fff';
      filterBtn.style.color = activeFilters.length ? '#fff' : 'var(--text)';
      filterBtn.innerHTML = `⚙️ ফিল্টার${activeFilters.length ? ' •'+activeFilters.length : ''}`;
    }
  }
  toast('ফিল্টার প্রয়োগ করা হয়েছে', 'ok');
}
window.applyFilters = applyFilters;

/* ==========================================================================
   📦 PRODUCT DETAIL
   ========================================================================== */
let pdState = { qty:1, color:null, size:null, activeImageIdx:0, colorOverride:null, totalSlides:0 };
let currentProductReviews = [];
let currentProductQuestions = [];

function renderProduct(id){
  const p = getProduct(id);
  if (!p) return renderNotFound();
  pdState = { qty:1, color:null, size:null, activeImageIdx:0, colorOverride:null, totalSlides:0 };
  if (S.recentlyViewed[0] !== id) {
    S.recentlyViewed = [id, ...S.recentlyViewed.filter(x=>x!==id)].slice(0, 10);
    save();
  }

  const off = p.mrp ? Math.round((1 - p.price/p.mrp) * 100) : 0;
  const wished = S.wishlist.includes(id);
  const cat = getCategory(p.category);
  const colors = normalizeColors(p.colors);
  const sizes = p.sizes || [];
  const video = getProductVideo(p);

  const allReviews = currentProductReviews;
  const avg = allReviews.length
    ? (allReviews.reduce((s,r) => s + (r.rating||0), 0) / allReviews.length)
    : (p.rating || 0);
  const totalCount = allReviews.length || p.reviewsCount || 0;

  const breakdown = [5,4,3,2,1].map(star => {
    const count = allReviews.filter(r => Math.round(r.rating) === star).length;
    const pct = allReviews.length ? Math.round(count/allReviews.length*100) : 0;
    return { star, pct, count };
  });

  let images = getProductImages(p);
  if (images.length === 0) images = [null];
  const totalSlides = images.length + (video ? 1 : 0);
  pdState.totalSlides = totalSlides;

  const related = smartSearchProducts('', { category: p.category, inStock:true }).filter(x=>x.id!==id).slice(0, 6);

  const thumbsHtml = `
  <div class="pd-thumbs-wrap">
    <div class="pd-thumbs-label">📷 ছবি ${video ? '+ ভিডিও ' : ''}(${bn(totalSlides)} টি)</div>
    <div class="pd-thumbs" id="pdThumbs">
      ${images.map((u, i) => `
        <button type="button" class="pd-thumb ${i===0?'active':''}" data-idx="${i}" onclick="selectProductImage(${i})" aria-label="ছবি ${i+1}">
          ${u
            ? `<img src="${fixImgUrl(u)}" alt="thumb ${i+1}" loading="lazy" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"><span class="pd-thumb-emoji" style="display:none">${p.emoji||'📦'}</span>`
            : `<span class="pd-thumb-emoji">${p.emoji||'📦'}</span>`}
        </button>
      `).join('')}
      ${video ? `<button type="button" class="pd-thumb video-thumb ${images.length===0?'active':''}" data-idx="${images.length}" onclick="selectProductImage(${images.length})" aria-label="ভিডিও">
        ${ICO.video}
      </button>` : ''}
    </div>
  </div>`;

  const canReview = canUserReviewProduct(id);
  const hasReviewed = S.reviewedProducts.includes(id);

  const reviewBtnHtml = canReview && !hasReviewed
    ? `<button class="btn btn-primary btn-block" style="margin-top:12px" data-id="${escAttr(p.id)}" onclick="openReviewSheet(this.dataset.id)">✍️ রিভিউ লিখুন</button>`
    : hasReviewed
      ? `<div style="text-align:center;padding:14px;color:var(--success);font-size:13px;font-weight:600;margin-top:8px">✅ আপনি এই পণ্যে রিভিউ দিয়েছেন</div>`
      : `<div style="text-align:center;padding:14px;color:var(--muted);font-size:12.5px;line-height:1.6;margin-top:8px;background:var(--surface-2);border-radius:10px">🔒 রিভিউ দিতে হলে পণ্যটি অর্ডার করে ডেলিভারি নিতে হবে</div>`;

  const sizeGuideBtn = (isSizeGuideEnabled() && (sizes.length || p.sizeGuide)) ? 
    `<button type="button" onclick="openSizeGuide('${escAttr(p.id)}')" style="margin-left:auto;color:var(--primary);font-size:12.5px;font-weight:600;display:inline-flex;align-items:center;gap:4px">${ICO.ruler} সাইজ গাইড</button>` : '';

  const qaList = currentProductQuestions;
  const qaHtml = qaList.length ? qaList.slice(0,3).map(q => `
    <div class="qa-item">
      <div class="qa-q"><span class="qa-badge">প্রশ্ন</span><span>${esc(q.question)}</span></div>
      ${(q.answers && q.answers.length) ? q.answers.slice(0,1).map(a => `
        <div class="qa-a"><span class="qa-badge" style="background:#dcfce7;color:#15803d">উত্তর</span><span>${esc(a.text)}</span></div>
        <div class="qa-meta">— ${esc(a.by || 'Must Look')} · ${esc(a.date || '')}</div>
      `).join('') : `<div class="qa-a" style="color:var(--muted);font-style:italic"><span class="qa-badge" style="background:#fef3c7;color:#92400e">অপেক্ষমাণ</span><span>উত্তরের অপেক্ষায়</span></div>`}
    </div>
  `).join('') : `<div style="text-align:center;padding:22px 0;color:var(--muted);font-size:13.5px">এখনো কোনো প্রশ্ন নেই — প্রথম প্রশ্নটি করুন</div>`;

  return `
  <div class="pd-gallery">
    <button class="pd-back" onclick="history.back()">${ICO.arrowL}</button>
    <button class="pd-share" data-id="${escAttr(p.id)}" onclick="shareProduct(this.dataset.id)">
      <svg class="ico" viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
    </button>
    <div class="pd-track noscroll" id="pdTrack">
      ${images.map((u,i) => `
        <div class="pd-slide" data-slide="${i}" onclick="openLightbox(${i})">
          ${u
            ? `<img src="${fixImgUrl(u)}" alt="${escAttr(p.name)}" loading="${i===0?'eager':'lazy'}" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"><span class="pcard-emoji" style="display:none;font-size:120px">${p.emoji||'📦'}</span>`
            : `<div class="pcard-emoji" style="font-size:120px">${p.emoji||'📦'}</div>`}
        </div>
      `).join('')}
      ${video ? `
        <div class="pd-video-slide" data-slide="${images.length}">
          <span class="pd-video-badge">🎬 ভিডিও</span>
          <video src="${escAttr(video)}" controls playsinline preload="metadata"></video>
        </div>
      ` : ''}
    </div>
    <div class="pd-dots" id="pdDots">
      ${Array.from({length: totalSlides}).map((_,i)=>`<i class="${i===0?'on':''}"></i>`).join('')}
    </div>
  </div>

  ${thumbsHtml}

  <div style="padding:14px 0 0">
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">
      ${p.badge ? `<span class="tag warn">${esc(p.badge)}</span>` : ''}
      ${cat ? `<span class="tag" data-goto="/category/${escAttr(cat.id || cat.name)}" onclick="go(this.dataset.goto)" style="cursor:pointer">${esc(cat.name)}</span>` : ''}
      <span class="tag ${p.stock > 0 ? 'ok' : 'err'}">${p.stock > 0 ? 'স্টকে আছে' : 'স্টক শেষ'}</span>
    </div>
    <h1 class="pd-title">${esc(p.name)}</h1>
    <div class="pd-stats">
      <span class="star">${ICO.star} ${bn(avg.toFixed(1))}</span>
      <span>${bn(totalCount)} রেটিং</span>
      <span>·</span>
      <span>${bn(p.sold||0)}+ বিক্রি</span>
    </div>
  </div>

  <div class="pd-price-box" style="border-radius:var(--r);margin-top:12px;border:1px solid var(--border)">
    <div class="pd-price">
      <span class="now">${money(p.price)}</span>
      ${p.mrp > p.price ? `<s>${money(p.mrp)}</s><span class="off">-${bn(off)}% ছাড়</span>` : ''}
    </div>
    <div style="font-size:12px;color:var(--muted);margin-top:6px">
      ${p.mrp > p.price ? `সাশ্রয় <b style="color:var(--success)">${money(p.mrp - p.price)}</b> · ` : ''} ভ্যাট অন্তর্ভুক্ত
    </div>
  </div>

  ${colors.length ? `
  <div class="card card-pad" style="margin-top:12px">
    <div class="var-label">রঙ: <span id="selColor">${esc(colors[0].name)}</span></div>
    <div class="color-swatches" id="colorOpts">
      ${colors.map((c, i) => {
        const light = isLightColor(c.hex);
        return `<button type="button" class="color-swatch ${i===0?'active':''}" data-color="${escAttr(c.name)}" onclick="pickColor(this)" title="${escAttr(c.name)}">
          <span class="sw-circle ${light?'sw-light':''}" style="background:${c.hex}"></span>
          <span class="sw-name">${esc(c.name)}</span>
        </button>`;
      }).join('')}
    </div>
  </div>` : ''}

  ${sizes.length ? `
  <div class="card card-pad" style="margin-top:10px">
    <div class="var-label" style="display:flex;align-items:center;gap:8px">সাইজ: <span id="selSize">${esc(sizes[0])}</span>${sizeGuideBtn}</div>
    <div class="var-opts" id="sizeOpts">
      ${sizes.map((s,i)=>`<button class="var-opt ${i===0?'active':''}" data-size="${escAttr(s)}" onclick="pickSize(this)">${esc(s)}</button>`).join('')}
    </div>
  </div>` : ''}

  <div class="card card-pad" style="margin-top:10px;display:flex;align-items:center;justify-content:space-between">
    <div>
      <div class="var-label" style="margin-bottom:2px">পরিমাণ</div>
      <div style="font-size:12px;color:var(--muted)">সর্বোচ্চ ${bn(p.stock)} পিস</div>
    </div>
    <div class="qty">
      <button onclick="pdQty(-1)">${ICO.minus}</button>
      <input id="pdQty" type="text" value="১" readonly>
      <button onclick="pdQty(1)">${ICO.plus}</button>
    </div>
  </div>

  <div class="card card-pad" style="margin-top:10px">
    <div class="info-row"><span class="ir-ico">${ICO.truck}</span><span class="ir-key">ডেলিভারি</span><span class="ir-val">সারা দেশে ${money(deliveryCharge())}<br><span style="color:var(--success);font-weight:600">${esc(localThana())} ${esc(localDistrict())}-এর ভিতরে ফ্রি</span></span></div>
    <div class="info-row"><span class="ir-ico">${ICO.shield}</span><span class="ir-key">ওয়ারেন্টি</span><span class="ir-val">${esc(p.warranty||'নেই')}</span></div>
    <div class="info-row"><span class="ir-ico">${ICO.refresh}</span><span class="ir-key">রিটার্ন</span><span class="ir-val" style="color:var(--primary);font-weight:600">ডেলিভারিম্যানের সামনে চেক করে নিতে হবে</span></div>
    <div class="info-row"><span class="ir-ico">${ICO.check}</span><span class="ir-key">অথেনটিসিটি</span><span class="ir-val">১০০% অরিজিনাল</span></div>
  </div>

  ${p.description ? `
  <section class="sec">
    <div class="sec-head"><h2 class="sec-title"><span class="accent"></span>বিবরণ</h2></div>
    <div class="card card-pad" style="font-size:14px;line-height:1.75;color:#3a3a3a">${esc(p.description)}</div>
  </section>` : ''}

  <section class="sec">
    <div class="sec-head">
      <h2 class="sec-title"><span class="accent"></span>রেটিং ও রিভিউ</h2>
    </div>
    <div class="card card-pad" id="reviewBox">
      <div class="rate-summary">
        <div class="rate-big"><div class="rb-num">${bn(avg.toFixed(1))}</div><div style="color:var(--star);font-size:13px">${'★'.repeat(Math.round(avg))}${'☆'.repeat(5-Math.round(avg))}</div><div class="rb-total">${bn(totalCount)} রেটিং</div></div>
        <div class="rate-bars">
          ${breakdown.map(b=>`<div class="rb-row"><span class="rb-star">${bn(b.star)} ★</span><span class="rb-track"><i style="width:${b.pct}%"></i></span><span class="rb-pct">${bn(b.pct)}%</span></div>`).join('')}
        </div>
      </div>
      <div id="reviewsListInner">
        ${allReviews.length ? allReviews.slice(0,5).map(r=>renderReviewItem(r)).join('') : `<div style="text-align:center;padding:22px 0;color:var(--muted);font-size:13.5px">এখনো কোনো রিভিউ নেই</div>`}
      </div>
      ${reviewBtnHtml}
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2 class="sec-title"><span class="accent"></span>প্রশ্ন ও উত্তর</h2>
      <button class="sec-more" data-id="${escAttr(p.id)}" onclick="openQuestionSheet(this.dataset.id)">প্রশ্ন করুন ›</button>
    </div>
    <div class="card card-pad" id="qaBox">
      <div id="qaListInner">${qaHtml}</div>
      <button class="btn btn-outline btn-block" style="margin-top:12px" data-id="${escAttr(p.id)}" onclick="openQuestionSheet(this.dataset.id)">❓ প্রশ্ন করুন</button>
    </div>
  </section>

  ${related.length ? `
  <section class="sec">
    <div class="sec-head"><h2 class="sec-title"><span class="accent"></span>সম্পর্কিত পণ্য</h2></div>
    <div class="p-grid">${related.map(productCard).join('')}</div>
  </section>` : ''}

  <div class="pd-sticky" id="pdBar">
    <button class="icon-act ${wished?'active':''}" data-id="${escAttr(p.id)}" onclick="toggleWish(this.dataset.id)">${ICO.heart}</button>
    <button class="btn btn-outline" data-id="${escAttr(p.id)}" onclick="addToCartFromProduct(this.dataset.id)">কার্টে যোগ</button>
    <button class="btn btn-primary" data-id="${escAttr(p.id)}" onclick="buyNow(this.dataset.id)">এখনই কিনুন</button>
  </div>
  <div style="height:80px"></div>
  ${siteFooter()}`;
}

function renderReviewItem(r){
  return `
    <div class="review-item">
      <div class="rev-head">
        <div class="rev-avatar">${esc((r.user||'গ')[0])}</div>
        <div style="flex:1"><div class="rev-name">${esc(r.user||'গ্রাহক')}</div><div class="rev-date">${esc(r.date||'')}</div></div>
        ${r.verified ? '<span class="rev-verified">✔ ভেরিফায়েড</span>' : ''}
      </div>
      <div class="rev-stars">${'★'.repeat(Math.round(r.rating))}${'☆'.repeat(5-Math.round(r.rating))}</div>
      <div class="rev-text">${esc(r.text)}</div>
      ${(r.images && r.images.length) || r.videoUrl ? `
        <div class="rev-images">
          ${(r.images||[]).map((imgUrl) => `<img src="${fixImgUrl(imgUrl)}" alt="review" loading="lazy" decoding="async" onclick="openVideoOrImageModal('image','${escAttr(imgUrl)}')">`).join('')}
          ${r.videoUrl ? `<div class="rev-video" onclick="openVideoOrImageModal('video','${escAttr(r.videoUrl)}')">${ICO.video}</div>` : ''}
        </div>
      ` : ''}
    </div>`;
}

function canUserReviewProduct(productId){
  const hasDelivered = S.orders.some(o => 
    o.status === 'delivered' && (o.items || []).some(it => it.id === productId)
  );
  if (hasDelivered) return true;
  if (S.paidProductIds.includes(productId)) return true;
  return false;
}

async function afterProduct(id){
  const p = getProduct(id);
  if (!p) return;
  const colors = normalizeColors(p.colors);
  const sizes = p.sizes || [];
  pdState = { qty:1, color: colors[0]?.name || null, size: sizes[0] || null, activeImageIdx: 0, colorOverride:null, totalSlides: pdState.totalSlides };

  const track = $('#pdTrack');
  const dots = $$('#pdDots i');
  if (track){
    track.addEventListener('scroll', ()=>{
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== pdState.activeImageIdx) {
        pdState.activeImageIdx = i;
        setActiveThumb(i);
        dots.forEach((d,k)=>d.classList.toggle('on', k===i));
      }
    }, { passive:true });
  }
  await loadProductReviewsRealtime(id);
  await loadProductQuestions(id);

  try {
    const userId = S.user?.uid || '';
    const phone = S.orders[0]?.phone 
               || S.checkout.guestPhone 
               || S.chatPhone
               || getPersistentGuestPhone()
               || (S.addresses.find(a => a?.phone)?.phone)
               || '';
    if (phone || userId){
      const deliveredIds = await FB.getDeliveredProducts(userId, phone);
      if (deliveredIds.length){
        S.paidProductIds = [...new Set([...S.paidProductIds, ...deliveredIds])];
        save();
      }
    }
  } catch(e){}
}

function selectProductImage(idx){
  const track = $('#pdTrack');
  if (!track) return;
  const slide = track.children[idx];
  if (!slide) return;
  track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
  pdState.activeImageIdx = idx;
  setActiveThumb(idx);
  $$('#pdDots i').forEach((d,k)=>d.classList.toggle('on', k===idx));
}
window.selectProductImage = selectProductImage;

function setActiveThumb(idx){
  const thumbs = $$('#pdThumbs .pd-thumb');
  thumbs.forEach((t, k) => t.classList.toggle('active', k === idx));
  const active = thumbs[idx];
  if (active && active.scrollIntoView){
    try { active.scrollIntoView({ behavior:'smooth', inline:'center', block:'nearest' }); } catch(e){}
  }
}

function pickColor(btn){
  const colorName = btn.dataset.color;
  if (!colorName) return;
  $$('#colorOpts .color-swatch').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  pdState.color = colorName;
  const lbl = $('#selColor');
  if (lbl) lbl.textContent = colorName;

  const id = parseHash().parts[1];
  const p = getProduct(id);
  if (!p) return;
  const colorImg = getImageForColor(p, colorName);
  if (colorImg){
    const imgs = getProductImages(p);
    let idx = imgs.findIndex(u => fixImgUrl(u) === fixImgUrl(colorImg));
    if (idx < 0){
      pdState.colorOverride = colorImg;
      const track = $('#pdTrack');
      if (track){
        const firstSlide = track.querySelector('.pd-slide');
        if (firstSlide){
          firstSlide.innerHTML = `<img src="${fixImgUrl(colorImg)}" alt="${escAttr(p.name)}" style="width:100%;height:100%;object-fit:cover">`;
        }
      }
      pdState.activeImageIdx = 0;
      setActiveThumb(0);
      $$('#pdDots i').forEach((d,k)=>d.classList.toggle('on', k===0));
      return;
    }
    selectProductImage(idx);
  }
}
window.pickColor = pickColor;

function pickSize(btn){
  const value = btn.dataset.size;
  if (!value) return;
  const parent = btn.parentElement;
  $$('.var-opt', parent).forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  pdState.size = value;
  const lbl = $('#selSize');
  if (lbl) lbl.textContent = value;
}
window.pickSize = pickSize;

function pdQty(delta){
  const p = getProduct(parseHash().parts[1]);
  if (!p) return;
  pdState.qty = Math.max(1, Math.min(pdState.qty + delta, p.stock));
  if ($('#pdQty')) $('#pdQty').value = bn(pdState.qty);
}
window.pdQty = pdQty;

function addToCartFromProduct(id){
  addToCart(id, pdState.qty, { color: pdState.color, size: pdState.size });
}
window.addToCartFromProduct = addToCartFromProduct;

function buyNow(id){
  addToCart(id, pdState.qty, { color: pdState.color, size: pdState.size });
  S.checkout.step = 1;
  save();
  go('/checkout');
}
window.buyNow = buyNow;

function shareProduct(id){
  const p = getProduct(id);
  if (!p) return;
  const url = location.origin + location.pathname + '#/product/' + id;
  if (navigator.share) {
    navigator.share({ title: p.name, text: p.name + ' — ' + money(p.price), url })
      .catch(err => {
        if (err.name !== 'AbortError') {
          navigator.clipboard?.writeText(url).then(
            ()=>toast('লিংক কপি হয়েছে', 'ok'),
            ()=>toast('লিংক: ' + url)
          );
        }
      });
  } else {
    navigator.clipboard?.writeText(url).then(
      ()=>toast('লিংক কপি হয়েছে', 'ok'),
      ()=>toast('লিংক: ' + url)
    );
  }
}
window.shareProduct = shareProduct;

