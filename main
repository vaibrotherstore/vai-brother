/* ==========================================================================
   🏠 ADDRESS SHEET
   ========================================================================== */
function openAddressSheet(editIdx = null){
  _editingAddressIdx = editIdx;
  const districts = Object.keys(BD_DATA).sort();
  const existing = (editIdx != null && S.addresses[editIdx]) ? S.addresses[editIdx] : null;
  const isEdit = !!existing;

  const body = `
    <div class="field"><label>প্রাপকের নাম <span class="req">*</span></label><input class="input" id="adName" placeholder="পুরো নাম" value="${escAttr(existing?.name || S.checkout.guestName || '')}"></div>
    <div class="field"><label>মোবাইল নম্বর <span class="req">*</span></label><input class="input" id="adPhone" type="tel" placeholder="01XXXXXXXXX" maxlength="11" value="${escAttr(existing?.phone || S.checkout.guestPhone || '')}"></div>
    <div class="field">
      <label>জেলা <span class="req">*</span></label>
      <select class="select" id="adDistrict" onchange="onDistrictChange()">
        <option value="">— জেলা নির্বাচন করুন —</option>
        ${districts.map(d => `<option value="${escAttr(d)}" ${existing?.district === d ? 'selected' : ''}>${esc(d)}</option>`).join('')}
      </select>
    </div>
    <div class="field">
      <label>থানা / উপজেলা <span class="req">*</span></label>
      <select class="select" id="adThana" onchange="onThanaChange()">
        <option value="">— প্রথমে জেলা নির্বাচন করুন —</option>
        ${existing?.district ? (BD_DATA[existing.district] || []).map(t => `<option value="${escAttr(t)}" ${existing?.thana === t ? 'selected' : ''}>${esc(t)}</option>`).join('') : ''}
      </select>
    </div>
    <div class="field"><label>এরিয়া <span class="req">*</span></label><input class="input" id="adArea" placeholder="যেমন: মিরপুর ১০" value="${escAttr(existing?.area || '')}"></div>
    <div class="field"><label>সম্পূর্ণ ঠিকানা <span class="req">*</span></label><textarea class="textarea" id="adAddress" placeholder="বাসা/রোড/ব্লক সহ">${esc(existing?.address || '')}</textarea></div>
    <div class="field"><label>ঠিকানার ধরন</label>
      <div style="display:flex;gap:8px">
        ${['বাসা', 'অফিস', 'অন্য'].map(t => `
          <button type="button" class="var-opt ${(existing?.tag === t || (!existing && t === 'বাসা')) ? 'active' : ''}" data-tag="${t}" onclick="pickTag(this)">${t === 'বাসা' ? '🏠' : t === 'অফিস' ? '🏢' : '📍'} ${t}</button>
        `).join('')}
      </div>
    </div>`;
  const foot = `<button class="btn btn-primary btn-block" onclick="saveAddress()">${isEdit ? '✓ আপডেট করুন' : 'ঠিকানা সেভ করুন'}</button>`;
  openSheet(isEdit ? 'ঠিকানা সম্পাদনা' : 'নতুন ঠিকানা', body, foot);
  _addrTag = existing?.tag || 'বাসা';
}
window.openAddressSheet = openAddressSheet;

function editAddress(idx){ idx = Number(idx); openAddressSheet(idx); }
window.editAddress = editAddress;

function deleteAddress(idx){
  idx = Number(idx);
  if (!confirm('এই ঠিকানাটি মুছে ফেলবেন?')) return;
  S.addresses.splice(idx, 1);
  if (S.checkout.address === idx) S.checkout.address = null;
  else if (S.checkout.address > idx) S.checkout.address--;
  save(); render();
  toast('ঠিকানা মুছে ফেলা হয়েছে');
}
window.deleteAddress = deleteAddress;

function onDistrictChange(){
  const district = $('#adDistrict').value;
  const thanaSelect = $('#adThana');
  if (!district){ thanaSelect.innerHTML = '<option value="">— প্রথমে জেলা নির্বাচন করুন —</option>'; return; }
  const thanas = BD_DATA[district] || [];
  thanaSelect.innerHTML = '<option value="">— থানা/উপজেলা নির্বাচন করুন —</option>' +
    thanas.map(t => `<option value="${escAttr(t)}">${esc(t)}</option>`).join('');
}
window.onDistrictChange = onDistrictChange;

function onThanaChange(){
  const thana = $('#adThana').value;
  const district = $('#adDistrict').value;
  const areaInput = $('#adArea');
  if (thana && !areaInput.value) areaInput.value = thana;
  if (district === localDistrict() && thana === localThana()){
    toast('🎉 লোকাল ফ্রি ডেলিভারি এলাকা!', 'ok');
  }
}
window.onThanaChange = onThanaChange;

function pickTag(btn){
  $$('.var-opt[data-tag]').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  _addrTag = btn.dataset.tag;
}
window.pickTag = pickTag;

function saveAddress(){
  const name = $('#adName').value.trim();
  const phone = $('#adPhone').value.trim();
  const district = $('#adDistrict').value;
  const thana = $('#adThana').value;
  const area = $('#adArea').value.trim();
  const address = $('#adAddress').value.trim();
  if (!name){ toast('নাম লিখুন', 'err'); return; }
  if (!/^01[3-9]\d{8}$/.test(phone)){ toast('সঠিক মোবাইল নম্বর দিন (১১ ডিজিট)', 'err'); return; }
  if (!district){ toast('জেলা নির্বাচন করুন', 'err'); return; }
  if (!thana){ toast('থানা/উপজেলা নির্বাচন করুন', 'err'); return; }
  if (!area){ toast('এরিয়া লিখুন', 'err'); return; }
  if (!address){ toast('সম্পূর্ণ ঠিকানা লিখুন', 'err'); return; }

  const addr = { name, phone, district, thana, area, address, tag: _addrTag || 'বাসা' };

  if (_editingAddressIdx != null && S.addresses[_editingAddressIdx]){
    S.addresses[_editingAddressIdx] = addr;
    toast('✓ ঠিকানা আপডেট হয়েছে', 'ok');
  } else {
    S.addresses.push(addr);
    S.checkout.address = S.addresses.length - 1;
    toast('✓ ঠিকানা সেভ হয়েছে', 'ok');
  }
  _editingAddressIdx = null;
  save();
  closeSheet();
  render();
}
window.saveAddress = saveAddress;

/* ==========================================================================
   🚀 PLACE ORDER
   ========================================================================== */
async function placeOrder(){
  const currentUser = (auth && auth.currentUser) || null;
  const isGuest = !currentUser;

  if (isGuest && !isGuestCheckoutEnabled()){
    pendingOrderAfterAuth = true;
    pendingOrderExpiry = Date.now() + 5 * 60 * 1000;
    try { sessionStorage.setItem('pending_order_after_auth', '1'); } catch(e){}
    try { sessionStorage.setItem('pending_checkout_state', JSON.stringify(S.checkout)); } catch(e){}
    openAuthSheet('signup', 'order');
    setTimeout(() => toast('অর্ডার কনফার্ম করতে অ্যাকাউন্ট তৈরি করুন', 'info'), 400);
    return;
  }

  const step = S.checkout.step;
  if (step !== 4){ toast('সব ধাপ সম্পন্ন করুন', 'err'); return; }
  if (!$('#agreeTerms')?.checked){ toast('শর্তাবলীতে সম্মতি দিন', 'err'); return; }

  const addr = S.addresses[S.checkout.address] || {};
  const guestName = (S.checkout.guestName || '').trim();
  const guestPhone = (S.checkout.guestPhone || '').trim();

  const finalName = addr.name || guestName || 'গেস্ট';
  const finalPhone = addr.phone || guestPhone || '';

  if (!finalPhone){ toast('মোবাইল নম্বর দিন', 'err'); return; }
  if (!addr.district || !addr.thana || !addr.address){ toast('সম্পূর্ণ ঠিকানা দিন', 'err'); openAddressSheet(); return; }

  const isLocalAddr = isLocalAddress(addr);
  const dc = deliveryChargeEffective();
  const pm = S.checkout.paymentMethod || 'bkash';

  if (!isLocalAddr){
    const trxInput = $('#bkashTrx');
    const trx = trxInput ? trxInput.value.trim() : (S.checkout.trxId || '');
    if (trx.length < 6){ toast('⚠️ TrxID দিন (কমপক্ষে ৬ অক্ষর)', 'err'); return; }
    S.checkout.trxId = trx;
    save();
  }

  const btn = $('#placeOrderBtn');
  if (btn){ btn.disabled = true; btn.innerHTML = '<span class="spinner" style="border-color:rgba(255,255,255,.4);border-top-color:#fff"></span> প্রসেস হচ্ছে...'; }

  try {
    if (db){
      for (const item of S.cart){
        const pDoc = await db.collection('products').doc(item.id).get();
        if (!pDoc.exists){
          toast(`"${getProduct(item.id)?.name || item.id}" আর নেই`, 'err');
          if (btn){ btn.disabled = false; btn.innerHTML = ICO.check + ' অর্ডার নিশ্চিত · ' + money(cartTotal()); }
          return;
        }
        const freshStock = Number(pDoc.data().stock || 0);
        if (freshStock < item.qty){
          const nm = pDoc.data().name || item.id;
          toast(`"${nm}" এর স্টক শেষ (মাত্র ${bn(freshStock)} পিস আছে)`, 'err');
          if (btn){ btn.disabled = false; btn.innerHTML = ICO.check + ' অর্ডার নিশ্চিত · ' + money(cartTotal()); }
          return;
        }
      }
    }
  } catch(e){ console.warn('Stock validation error:', e); }

  let orderId;
  try { orderId = await FB.getNextOrderId(); }
  catch(e){ orderId = '#' + Date.now().toString().slice(-6); }

  const sub = cartSubtotal();
  const disc = discountAmount();
  const total = cartTotal();
  const paidAdvance = isLocalAddr ? 0 : dc;
  const dueOnDelivery = isLocalAddr ? total : (sub - disc);

  const userId = currentUser ? currentUser.uid : ('guest_' + finalPhone);

  const order = {
    id: orderId,
    userId,
    isGuest: isGuest,
    userEmail: currentUser ? (currentUser.email || '') : '',
    userName: currentUser ? (currentUser.displayName || '') : finalName,
    name: finalName,
    phone: finalPhone,
    city: addr.district || '',
    thana: addr.thana || '',
    area: addr.area || '',
    address: addr.address || '',
    isLocal: isLocalAddr,
    items: S.cart.map(i => {
      const p = getProduct(i.id);
      return { id:i.id, name:p?.name, price:p?.price, qty:i.qty, variant:i.variant, image:getProductImage(p)||'', emoji:p?.emoji||'🛍️' };
    }),
    subtotal: sub,
    discount: disc,
    delivery: dc,
    total,
    paidAdvance,
    dueOnDelivery,
    coupon: S.coupon,
    payment: isLocalAddr ? 'লোকাল ক্যাশ অন ডেলিভারি' : (pm === 'nagad' ? 'নগদ (আগে) + COD' : 'বিকাশ (আগে) + COD'),
    paymentName: isLocalAddr ? 'লোকাল ক্যাশ অন ডেলিভারি' : (pm === 'nagad' ? 'নগদ (ডেলিভারি চার্জ আগে) + COD' : 'বিকাশ (ডেলিভারি চার্জ আগে) + COD'),
    paymentMethod: isLocalAddr ? 'local' : pm,
    paymentTrxStatus: isLocalAddr ? 'not-needed' : 'unverified',
    trxId: isLocalAddr ? '' : (S.checkout.trxId || ''),
    note: $('#orderNote')?.value || '',
    status: 'pending',
    trackingId: 'TRK' + Math.random().toString(36).slice(2,10).toUpperCase(),
    timeline: [{ status:'pending', at: Date.now() }]
  };

  try {
    const res = await FB.placeOrder(order);
    if (res && res.id) order.id = res.id;
  } catch(e){
    toast('⚠️ ' + (e.message || 'অর্ডার ব্যর্থ'), 'err');
    if (btn){ btn.disabled = false; btn.innerHTML = ICO.check + ' অর্ডার নিশ্চিত · ' + money(cartTotal()); }
    return;
  }

  try { await FB.notifyOrder(order); } catch(e){}

  S.orders = [order, ...S.orders.filter(x => x.id !== order.id)];
  S._serverOrderIds = [...new Set([...S._serverOrderIds, order.id])];
  S.cart = [];
  S.coupon = null;
  S.checkout = { step:1, address:null, trxId:'', paymentMethod:'bkash', guestPhone:'', guestName:'' };

  if (!isGuest && currentUser){
    S.checkout.guestPhone = '';
  } else if (finalPhone){
    S.chatPhone = finalPhone;
    setPersistentGuestPhone(finalPhone);
  }
  save();

  if (isGuest && finalPhone) startGuestOrdersListener(finalPhone);
  else if (currentUser) startUserOrdersListener(currentUser.uid);

  go('/success/' + encodeURIComponent(order.id));
  toast('অর্ডার সফল হয়েছে! 🎉', 'ok');
}
window.placeOrder = placeOrder;

/* ==========================================================================
   🎉 SUCCESS
   ========================================================================== */
let _successRetry = 0;
function renderSuccess(orderId){
  const id = decodeURIComponent(orderId);
  const o = S.orders.find(x => x.id === id);
  if (!o){
    if (_successRetry > 10) {
      return `<div class="empty-state"><h3>অর্ডার লোড করা যাচ্ছে না</h3><p>ইন্টারনেট চেক করে আবার চেষ্টা করুন</p><button class="btn btn-primary" onclick="go('/home')">হোমে ফিরুন</button></div>`;
    }
    _successRetry++;
    setTimeout(() => {
      const { parts } = parseHash();
      if (parts[0] === 'success') render();
    }, 900);
    return `<div class="empty-state">
      <div class="es-ico">${ICO.box}</div>
      <h3>অর্ডার লোড হচ্ছে...</h3>
      <div class="spinner" style="width:32px;height:32px;border:3px solid #e5e5e5;border-top-color:#1a1a1a;margin:20px auto 0"></div>
    </div>`;
  }
  _successRetry = 0;
  const guestNote = o.isGuest ? `
    <div class="notice" style="margin-top:12px;background:#eff6ff;color:#1e40af">
      <span class="n-ico">${ICO.info}</span>
      <span><b>গেস্ট অর্ডার:</b> এই অর্ডারটি <b>${esc(o.phone)}</b> নাম্বারের সাথে সংযুক্ত।<br><br>
      💡 <b>অ্যাকাউন্ট তৈরি করলে</b> আরও সুবিধা পাবেন।</span>
    </div>` : '';

  return `
  <div style="text-align:center;padding:34px 10px 20px">
    <div style="width:88px;height:88px;border-radius:50%;background:var(--success-soft);display:grid;place-items:center;color:var(--success);margin:0 auto 18px;animation:tin .5s var(--ease)">
      <svg class="ico" viewBox="0 0 24 24" style="width:44px;height:44px;stroke-width:2.5"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h1 style="font-size:22px;font-weight:700">অর্ডার সফল হয়েছে!</h1>
    <p style="color:var(--muted);font-size:14px;margin-top:8px;line-height:1.7">আপনার অর্ডারটি আমরা পেয়েছি।</p>
  </div>
  <div class="card card-pad">
    <div class="info-row"><span class="ir-ico">${ICO.doc}</span><span class="ir-key">সিরিয়াল</span><span class="ir-val" style="font-weight:800;font-size:18px;color:var(--primary)">${esc(o.id)}</span></div>
    <div class="info-row"><span class="ir-ico">${ICO.link}</span><span class="ir-key">ট্র্যাকিং</span><span class="ir-val">${esc(o.trackingId)}</span></div>
    <div class="info-row"><span class="ir-ico">${ICO.money}</span><span class="ir-key">মোট</span><span class="ir-val" style="color:var(--primary);font-weight:700">${money(o.total)}</span></div>
    <div class="info-row"><span class="ir-ico">${ICO.card}</span><span class="ir-key">পেমেন্ট</span><span class="ir-val">${esc(o.paymentName)}</span></div>
  </div>
  ${guestNote}
  <div style="display:flex;gap:10px;margin-top:16px">
    <button class="btn btn-outline" style="flex:1" onclick="go('/orders')">আমার অর্ডার</button>
    <button class="btn btn-primary" style="flex:1" data-goto="/order/${encodeURIComponent(o.id)}" onclick="go(this.dataset.goto)">ট্র্যাক করুন</button>
  </div>
  <button class="btn btn-ghost btn-block" style="margin-top:10px" onclick="go('/chat')">💬 অ্যাডমিনের সাথে চ্যাট</button>
  <button class="btn btn-ghost btn-block" style="margin-top:8px" onclick="go('/home')">হোমে ফিরুন</button>
  ${siteFooter()}`;
}

/* ==========================================================================
   📦 ORDERS LIST
   ========================================================================== */
function renderOrders(){
  if (!S.user && S.orders.length === 0){
    return `<div class="empty-state">
      <div class="es-ico">${ICO.user}</div>
      <h3>লগইন করুন</h3>
      <p>অর্ডার হিস্টোরি দেখতে প্রথমে লগইন করুন</p>
      <button class="btn btn-primary" onclick="openAuthSheet('login')">লগইন করুন</button>
    </div>${siteFooter()}`;
  }
  if (!S.orders.length){
    return `<div class="empty-state"><div class="es-ico">${ICO.mailEmpty}</div><h3>কোনো অর্ডার নেই</h3><p>আপনার অর্ডার হিস্টোরি এখানে দেখা যাবে</p><button class="btn btn-primary" onclick="go('/home')">শপিং শুরু করুন</button></div>${siteFooter()}`;
  }
  return `
  <div style="padding:14px 2px 12px">
    <h1 style="font-size:18px;font-weight:700">আমার অর্ডার</h1>
    <div style="font-size:12.5px;color:var(--muted);margin-top:3px">${bn(S.orders.length)} টি অর্ডার</div>
  </div>
  ${S.orders.map(o => {
    const st = ORDER_STATUSES.find(s => s.key === o.status) || ORDER_STATUSES[0];
    const statusClass = o.status === 'cancelled' ? 'cancelled' : o.status;
    const statusLabel = o.status === 'cancelled' ? '❌ বাতিল' : st.label;
    const localBadge = o.isLocal ? `<span class="local-badge">🏍️ লোকাল</span>` : '';
    const guestBadge = o.isGuest ? `<span class="tag" style="background:#eff6ff;color:#1e40af;font-size:10px">গেস্ট</span>` : '';
    let paidBadge;
    if (o.isLocal){
      paidBadge = `<div class="paid-badge local-paid-badge">🏍️ লোকাল — অগ্রিম নেই</div>`;
    } else if (o.paymentTrxStatus === 'verified'){
      paidBadge = `<div class="paid-badge full">✅ পেমেন্ট ভেরিফাইড</div>`;
    } else if (o.paymentTrxStatus === 'rejected'){
      paidBadge = `<div class="paid-badge partial" style="background:#fee2e2;color:#991b1b">❌ TrxID বাতিল</div>`;
    } else {
      paidBadge = `<div class="paid-badge partial">⏳ পেমেন্ট যাচাই বাকি · ৳${bn(o.paidAdvance)} আগে দিয়েছেন</div>`;
    }
    return `
    <div class="msg-card" style="margin-bottom:10px" data-goto="/order/${encodeURIComponent(o.id)}" onclick="go(this.dataset.goto)">
      <div class="msg-card-hd">
        <div class="msg-id">${esc(o.id)} ${localBadge} ${guestBadge} <small>· ${new Date(o.createdAt || Date.now()).toLocaleDateString('bn-BD', {day:'numeric',month:'short'})}</small></div>
        <span class="msg-status ${statusClass}">${statusLabel}</span>
      </div>
      <div class="msg-items">${(o.items||[]).slice(0,3).map(i=>`• ${esc(i.name)} × ${bn(i.qty)}`).join('<br>')}${(o.items||[]).length>3?`<br>• আরও ${bn(o.items.length-3)} টি...`:''}</div>
      <div class="msg-total"><span>সর্বমোট</span><b>${money(o.total)}</b></div>
      ${paidBadge}
    </div>`;
  }).join('')}
  ${siteFooter()}`;
}

function afterOrders(){
  if (S.user) return;
  const guestPhone = S.orders[0]?.phone
                  || S.checkout.guestPhone
                  || S.chatPhone
                  || getPersistentGuestPhone()
                  || (S.addresses.find(a => a?.phone)?.phone);
  if (!guestPhone) return;
  if (_guestOrdersLoaded && _guestOrdersLoadedPhone === guestPhone) return;
  if (_guestOrdersLoading) return;
  _guestOrdersLoading = true;
  loadGuestOrdersFromFirestore(guestPhone).finally(() => {
    _guestOrdersLoading = false;
    _guestOrdersLoaded = true;
    _guestOrdersLoadedPhone = guestPhone;
  });
  startGuestOrdersListener(guestPhone);
}

async function loadGuestOrdersFromFirestore(phone){
  if (!db || !phone) return;
  try {
    const arr = await FB.loadGuestOrders(phone);
    if (arr.length){
      const serverIds = new Set(arr.map(o => o.id));
      const localOnly = S.orders.filter(o => !serverIds.has(o.id) && !S._serverOrderIds.includes(o.id));
      S.orders = [...arr, ...localOnly].sort((a,b) => (b.createdAt || 0) - (a.createdAt || 0));
      save();
    }
  } catch(e){ console.warn('loadGuestOrders error:', e); }
}

function startGuestOrdersListener(phone){
  if (guestOrdersListener){ try { guestOrdersListener(); } catch(e){} guestOrdersListener = null; }
  if (!db || !phone) return;
  try {
    guestOrdersListener = db.collection('orders')
      .where('phone', '==', phone)
      .onSnapshot(snap => {
        const arr = [];
        snap.forEach(doc => {
          const d = doc.data();
          arr.push({
            ...d,
            id: doc.id,
            createdAt: d.createdAt?.toMillis ? d.createdAt.toMillis() : (typeof d.createdAt === 'number' ? d.createdAt : Date.now()),
            updatedAt: d.updatedAt?.toMillis ? d.updatedAt.toMillis() : (typeof d.updatedAt === 'number' ? d.updatedAt : Date.now())
          });
        });
        arr.sort((a,b) => (b.createdAt || 0) - (a.createdAt || 0));

        const serverIds = new Set(arr.map(o => o.id));
        S._serverOrderIds = [...new Set([...S._serverOrderIds, ...serverIds])];
        const localOnly = S.orders.filter(o => !serverIds.has(o.id) && !S._serverOrderIds.includes(o.id));
        S.orders = [...arr, ...localOnly].sort((a,b) => (b.createdAt || 0) - (a.createdAt || 0));

        const deliveredIds = [];
        arr.forEach(o => {
          if (o.status === 'delivered') (o.items || []).forEach(it => deliveredIds.push(it.id));
        });
        if (deliveredIds.length){
          S.paidProductIds = [...new Set([...S.paidProductIds, ...deliveredIds])];
        }
        save();

        arr.forEach(o => {
          const prev = prevOrderStatusMap[o.id];
          if (prev && prev !== o.status){
            const label = {
              pending:'⏳ পেন্ডিং', confirmed:'✓ কনফার্মড',
              processing:'⚙️ প্রসেসিং', shipped:'🚚 শিপড',
              out:'🛵 ডেলিভারিতে', delivered:'📬 ডেলিভার্ড',
              cancelled:'❌ বাতিল'
            }[o.status] || o.status;
            toast(`অর্ডার ${o.id}: ${label}`, o.status === 'cancelled' ? 'err' : 'ok');
          }
          prevOrderStatusMap[o.id] = o.status;
        });

        const page = parseHash().parts[0];
        if (['orders','order','success','account'].includes(page)) render();
      }, err => {
        console.warn('[GuestOrders] listener error:', err);
      });
  } catch(e){
    console.warn('[GuestOrders] start error:', e);
  }
}

async function cancelOrder(orderId){
  if (!confirm('আপনি কি এই অর্ডারটি বাতিল করতে চান?')) return;
  const o = S.orders.find(x => x.id === orderId);
  if (!o) return;
  if (o.status !== 'pending' && o.status !== 'confirmed'){ toast('এই অর্ডার আর বাতিল করা যাবে না', 'err'); return; }
  try { await FB.cancelOrder(orderId); } catch(e){}
  o.status = 'cancelled';
  o.timeline = o.timeline || [];
  o.timeline.push({ status:'cancelled', at: Date.now() });
  for (const it of (o.items || [])){
    const p = getProduct(it.id);
    if (p) p.stock = (p.stock || 0) + it.qty;
    S.paidProductIds = S.paidProductIds.filter(id => id !== it.id);
  }
  save(); render();
  toast('অর্ডার বাতিল হয়েছে', 'ok');
}
window.cancelOrder = cancelOrder;

async function reorder(orderId){
  const o = S.orders.find(x => x.id === orderId);
  if (!o) return;
  let added = 0;
  for (const it of (o.items || [])){
    const p = getProduct(it.id);
    const stock = Number(p?.stock) || 0;
    if (!p || stock <= 0) continue;
    const sortedVariant = Object.keys(it.variant || {}).sort().reduce((acc, k) => { acc[k] = it.variant[k]; return acc; }, {});
    const key = it.id + '::' + JSON.stringify(sortedVariant);
    const existing = S.cart.find(c => c.key === key);
    if (existing) existing.qty = Math.min(stock, existing.qty + it.qty);
    else S.cart.push({ key, id: it.id, qty: Math.min(stock, it.qty), variant: it.variant || {} });
    added++;
  }
  if (added === 0){ toast('কোনো পণ্য যোগ করা যায়নি', 'err'); return; }
  save();
  toast(`${bn(added)} টি পণ্য কার্টে যোগ হয়েছে`, 'ok');
  go('/cart');
}
window.reorder = reorder;

/* ==========================================================================
   🚚 ORDER DETAIL
   ========================================================================== */
function renderOrderDetail(idEnc){
  const id = decodeURIComponent(idEnc);
  const o = S.orders.find(x => x.id === id);
  if (!o) return renderNotFound();
  const currentIdx = ORDER_STATUSES.findIndex(s => s.key === o.status);
  const isCancelled = o.status === 'cancelled';

  return `
  <div style="display:flex;align-items:center;gap:10px;padding:14px 2px 12px">
    <button class="icon-btn" style="width:36px;height:36px;flex:0 0 36px" onclick="go('/orders')">${ICO.arrowL}</button>
    <h1 style="font-size:17px;font-weight:700">অর্ডার ট্র্যাকিং</h1>
  </div>
  <div class="card card-pad">
    <div style="display:flex;justify-content:space-between;align-items:flex-start">
      <div><div style="font-size:12px;color:var(--muted)">সিরিয়াল নম্বর</div><div style="font-size:18px;font-weight:800;margin-top:2px;color:var(--primary)">${esc(o.id)}</div></div>
      <span class="msg-status ${isCancelled?'cancelled':o.status}">${isCancelled ? '❌ বাতিল' : esc(ORDER_STATUSES.find(s=>s.key===o.status)?.label||'')}</span>
    </div>
    <div class="divider"></div>
    <div style="display:flex;justify-content:space-between;font-size:13px"><span style="color:var(--muted)">ট্র্যাকিং আইডি</span><b>${esc(o.trackingId)}</b></div>
    <div style="display:flex;justify-content:space-between;font-size:13px;margin-top:7px"><span style="color:var(--muted)">তারিখ</span><b>${new Date(o.createdAt || Date.now()).toLocaleDateString('bn-BD', {day:'numeric',month:'long',year:'numeric'})}</b></div>
  </div>

  ${!isCancelled ? `
  <div class="card card-pad" style="margin-top:12px">
    <div style="font-size:15px;font-weight:700;margin-bottom:16px">🚚 ডেলিভারি স্ট্যাটাস</div>
    <div class="track">
      ${ORDER_STATUSES.map((s,i)=>{
        const done = i < currentIdx;
        const cur = i === currentIdx;
        const t = (o.timeline||[]).find(x => x.status === s.key);
        return `<div class="track-step ${done?'done':''} ${cur?'current':''}">
          <div class="ts-dot">${done ? ICO.check : s.icon}</div>
          <div class="ts-title">${esc(s.label)}</div>
          <div class="ts-time">${t ? new Date(t.at).toLocaleString('bn-BD', {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) : (done ? 'সম্পন্ন' : 'অপেক্ষমাণ')}</div>
        </div>`;
      }).join('')}
    </div>
  </div>` : `<div class="notice err" style="margin-top:12px"><span class="n-ico">${ICO.info}</span><span>এই অর্ডারটি বাতিল করা হয়েছে।</span></div>`}

  ${o.paymentTrxStatus === 'rejected' ? `
  <div class="notice err" style="margin-top:12px">
    <span class="n-ico">${ICO.info}</span>
    <span><b>⚠️ TrxID সমস্যা:</b> ${esc(o.paymentRejectReason || 'TrxID যাচাই করা যায়নি')}<br><br><button class="btn btn-sm btn-primary" onclick="go('/chat')">💬 অ্যাডমিনের সাথে কথা বলুন</button></span>
  </div>` : ''}

  <div class="card card-pad" style="margin-top:12px">
    <div style="font-size:14px;font-weight:700;margin-bottom:10px">🛍️ পণ্যসমূহ</div>
    ${(o.items||[]).map(i=>{
      const url = i.image ? fixImgUrl(i.image) : null;
      const v = i.variant || {};
      const vText = [v.color, v.size].filter(Boolean).join(' · ');
      return `<div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
        ${url ? `<img src="${url}" style="width:50px;height:50px;border-radius:10px;object-fit:cover" loading="lazy" onerror="this.style.display='none'">` : `<div style="width:50px;height:50px;border-radius:10px;background:var(--surface-2);display:grid;place-items:center;font-size:24px">${i.emoji||'🛍️'}</div>`}
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">${esc(i.name)}</div>
          ${vText ? `<div style="font-size:11.5px;color:var(--muted);margin-top:2px">${esc(vText)}</div>` : ''}
          <div style="font-size:11.5px;color:var(--muted);margin-top:2px">পরিমাণ: ${bn(i.qty)}</div>
        </div>
        <div style="font-weight:700;color:var(--primary);font-size:13.5px">${money(i.price * i.qty)}</div>
      </div>`;
    }).join('')}
  </div>

  <div class="card card-pad" style="margin-top:12px">
    <div style="font-size:14px;font-weight:700;margin-bottom:10px">📍 ডেলিভারি ঠিকানা</div>
    <div style="font-size:13.5px;line-height:1.7">
      <b>${esc(o.name || '')}</b><br>${esc(o.phone || '')}<br>${esc(o.address || '')}, ${esc(o.area || '')}${o.thana ? ', '+esc(o.thana) : ''}, ${esc(o.city || '')}
    </div>
  </div>

  <div class="card card-pad" style="margin-top:12px">
    <div class="summary-row"><span>সাবটোটাল</span><span class="val">${money(o.subtotal)}</span></div>
    ${o.discount > 0 ? `<div class="summary-row"><span>ছাড়</span><span class="val" style="color:var(--success)">− ${money(o.discount)}</span></div>` : ''}
    <div class="summary-row"><span>ডেলিভারি</span><span class="val">${o.delivery === 0 ? 'ফ্রি' : money(o.delivery)}</span></div>
    <div class="summary-row total"><span>সর্বমোট</span><span class="val">${money(o.total)}</span></div>
    <div style="font-size:12.5px;color:var(--muted);margin-top:8px">পেমেন্ট: <b>${esc(o.paymentName)}</b>${o.trxId ? ' · TrxID: '+esc(o.trxId) : ''}</div>
  </div>

  ${o.status === 'delivered' ? `
  <div class="notice ok" style="margin-top:12px">
    <span class="n-ico">${ICO.info}</span>
    <span><b>✅ ডেলিভারি সম্পন্ন।</b> পণ্য নিয়ে কোনো সমস্যা থাকলে অনুগ্রহ করে অ্যাডমিনের সাথে চ্যাট করুন।</span>
  </div>` : ''}

  <div style="display:flex;gap:10px;margin-top:14px;flex-wrap:wrap">
    ${o.status === 'pending' || o.status === 'confirmed' ? `<button class="order-cancel-btn" style="flex:1;margin-top:0" data-id="${escAttr(o.id)}" onclick="cancelOrder(this.dataset.id)">${ICO.x} অর্ডার বাতিল</button>` : ''}
    ${o.status === 'delivered' || o.status === 'cancelled' ? `<button class="order-reorder-btn" style="flex:1;margin-top:0" data-id="${escAttr(o.id)}" onclick="reorder(this.dataset.id)">${ICO.refresh} আবার অর্ডার</button>` : ''}
    <button class="btn btn-primary" style="flex:1" onclick="go('/chat')">${ICO.chat} অ্যাডমিনের সাথে চ্যাট</button>
  </div>
  <div style="height:20px"></div>
  ${siteFooter()}`;
}
</script>

<script>
/* ==========================================================================
   ❤️ WISHLIST
   ========================================================================== */
function renderWishlist(){
  const items = S.wishlist.map(getProduct).filter(Boolean);
  if (!items.length){
    return `<div class="empty-state"><div class="es-ico">${ICO.heart}</div><h3>উইশলিস্ট খালি</h3><p>পছন্দের পণ্যে ♡ চেপে<br>উইশলিস্টে যোগ করুন</p><button class="btn btn-primary" onclick="go('/home')">পণ্য দেখুন</button></div>${siteFooter()}`;
  }
  return `
  <div style="padding:14px 2px 12px">
    <h1 style="font-size:18px;font-weight:700">আমার উইশলিস্ট</h1>
    <div style="font-size:12.5px;color:var(--muted);margin-top:3px">${bn(items.length)} টি পণ্য</div>
  </div>
  <div style="display:flex;gap:8px;margin-bottom:12px">
    <button class="btn btn-sm btn-primary" onclick="addAllWishToCart()">${ICO.cart} সব কার্টে যোগ</button>
    <button class="btn btn-sm btn-ghost" onclick="clearWishlist()">সব মুছুন</button>
  </div>
  <div class="p-grid">${items.map(productCard).join('')}</div>
  ${siteFooter()}`;
}
function addAllWishToCart(){
  const items = S.wishlist.map(getProduct).filter(Boolean);
  if (!items.length) return;
  let added = 0, failed = 0;
  items.forEach(p => { if (p.stock > 0){ addToCart(p.id, 1); added++; } else failed++; });
  if (added === 0) toast('কোনো পণ্য স্টকে নেই', 'err');
  else if (failed) toast(`${bn(added)} টি যোগ হয়েছে, ${bn(failed)} টি স্টক শেষ`);
  else toast(`${bn(added)} টি পণ্য কার্টে যোগ হয়েছে`, 'ok');
  go('/cart');
}
function clearWishlist(){
  if (!confirm('উইশলিস্ট থেকে সব পণ্য মুছে ফেলবেন?')) return;
  S.wishlist = []; save(); render();
  toast('উইশলিস্ট খালি করা হয়েছে');
}
window.addAllWishToCart = addAllWishToCart; window.clearWishlist = clearWishlist;

/* ==========================================================================
   ⚖️ COMPARE
   ========================================================================== */
function renderCompare(){
  const items = S.compare.map(getProduct).filter(Boolean);
  if (!items.length){
    return `<div class="empty-state"><div class="es-ico">${ICO.doc}</div><h3>তুলনার তালিকা খালি</h3><p>প্রোডাক্ট পেজে ⇄ বাটন চেপে<br>সর্বোচ্চ ৩টি পণ্য তুলনা করুন</p><button class="btn btn-primary" onclick="go('/home')">পণ্য দেখুন</button></div>${siteFooter()}`;
  }
  const rows = [
    { label:'ছবি', render:p => `<img src="${imgFor(p,0,300)}" alt="${escAttr(p.name)}" style="border-radius:10px;margin-bottom:8px" loading="lazy" onerror="this.style.display='none'">` },
    { label:'নাম', render:p => `<div style="font-weight:600;font-size:13px;line-height:1.4">${esc(p.name)}</div>` },
    { label:'দাম', render:p => `<span style="color:var(--primary);font-weight:700;font-size:15px">${money(p.price)}</span>` },
    { label:'MRP', render:p => `<s style="color:var(--muted)">${money(p.mrp)}</s>` },
    { label:'ছাড়', render:p => `<span style="color:var(--danger);font-weight:600">${bn(Math.round((1 - p.price/p.mrp)*100))}%</span>` },
    { label:'ব্র্যান্ড', render:p => esc(p.brand||'—') },
    { label:'রেটিং', render:p => `<span style="color:var(--star)">★</span> ${bn(p.rating||0)}` }
  ];
  return `
  <div style="padding:14px 2px 12px"><h1 style="font-size:18px;font-weight:700">পণ্য তুলনা</h1></div>
  <div class="card" style="overflow-x:auto">
    <table style="border-collapse:collapse;width:100%;min-width:max-content;font-size:13px">
      <tr><th></th>${items.map(p=>`<th style="padding:11px 13px;background:var(--surface-2);text-align:center;min-width:150px">${esc(p.brand||'পণ্য')}</th>`).join('')}</tr>
      ${rows.map(r=>`<tr><td style="padding:11px 13px;background:var(--surface-2);font-weight:600;color:var(--muted);position:sticky;left:0">${esc(r.label)}</td>${items.map(p=>`<td style="padding:11px 13px;border-bottom:1px solid var(--border);min-width:150px">${r.render(p)}</td>`).join('')}</tr>`).join('')}
    </table>
  </div>
  <button class="btn btn-ghost btn-block" style="margin-top:14px" onclick="S.compare=[];save();render()">সব সরান</button>
  ${siteFooter()}`;
}

