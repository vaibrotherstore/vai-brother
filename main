    guideHtml = `<table class="size-guide-table">
      <tr>${headers.map(h => `<th>${esc(h)}</th>`).join('')}</tr>
      ${p.sizeGuide.map(row => `<tr>${headers.map(h => `<td>${esc(row[h]||'')}</td>`).join('')}</tr>`).join('')}
    </table>`;
  } else {
    const cat = (p.category || '').toLowerCase();
    if (cat.includes('shirt') || cat.includes('টি-শার্ট') || cat.includes('tshirt') || cat.includes('panjabi') || cat.includes('পাঞ্জাবি')){
      guideHtml = `<table class="size-guide-table">
        <tr><th>সাইজ</th><th>বুক (ইঞ্চি)</th><th>লম্বা (ইঞ্চি)</th><th>কাঁধ (ইঞ্চি)</th></tr>
        <tr><td>S</td><td>36</td><td>27</td><td>16</td></tr>
        <tr><td>M</td><td>38</td><td>28</td><td>17</td></tr>
        <tr><td>L</td><td>40</td><td>29</td><td>18</td></tr>
        <tr><td>XL</td><td>42</td><td>30</td><td>19</td></tr>
        <tr><td>XXL</td><td>44</td><td>31</td><td>20</td></tr>
      </table>`;
    } else if (cat.includes('pant') || cat.includes('প্যান্ট') || cat.includes('jeans')){
      guideHtml = `<table class="size-guide-table">
        <tr><th>সাইজ</th><th>কোমর (ইঞ্চি)</th><th>লম্বা (ইঞ্চি)</th></tr>
        <tr><td>28</td><td>28</td><td>38</td></tr>
        <tr><td>30</td><td>30</td><td>38</td></tr>
        <tr><td>32</td><td>32</td><td>39</td></tr>
        <tr><td>34</td><td>34</td><td>39</td></tr>
        <tr><td>36</td><td>36</td><td>40</td></tr>
      </table>`;
    } else {
      guideHtml = `<table class="size-guide-table">
        <tr><th>সাইজ</th><th>মাপ (ইঞ্চি)</th></tr>
        <tr><td>Small</td><td>30-32</td></tr>
        <tr><td>Medium</td><td>32-34</td></tr>
        <tr><td>Large</td><td>34-36</td></tr>
        <tr><td>XL</td><td>36-38</td></tr>
      </table>`;
    }
  }
  const body = `
    <div style="font-size:14px;font-weight:700;margin-bottom:10px">${esc(p.name)}</div>
