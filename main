const SCROLL_POSITIONS = {};

function saveScrollPosition(hash, y){
  SCROLL_POSITIONS[hash] = y;
  const keys = Object.keys(SCROLL_POSITIONS);
  if (keys.length > 50) delete SCROLL_POSITIONS[keys[0]];
}
function getSavedScroll(hash){
  if (!(hash in SCROLL_POSITIONS)) return null;
  const v = SCROLL_POSITIONS[hash];
  return typeof v === 'number' ? v : null;
}

window.addEventListener('pagehide', () => {
  try { saveScrollPosition(location.hash || '#/home', window.scrollY || 0); } catch(e){}
});

