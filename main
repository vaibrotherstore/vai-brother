        <div style="font-size:14px;font-weight:700;margin-bottom:10px">🛍️ পণ্যসমূহ (${bn(cartCount())})</div>
        ${S.cart.map(item => {
          const p = getProduct(item.id); if (!p) return '';
          const v = item.variant || {};
          const vText = [v.color, v.size].filter(Boolean).join(' · ');
          return `<div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
