  const appName = InAppBrowser.name();
  const isAndroidDevice = InAppBrowser.isAndroid();
  const url = window.location.href;
  const cleanHost = url.replace(/^https?:\/\//, '').replace(/#/g, '%23');
  const body = `
    <div style="text-align:center;padding:16px 0 8px">
      <div style="width:84px;height:84px;border-radius:50%;background:linear-gradient(135deg,#4285F4,#34A853);display:grid;place-items:center;margin:0 auto 18px;box-shadow:0 10px 28px rgba(66,133,244,.32)">
        <svg width="42" height="42" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z" fill="#fff"/>
          <path d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z" fill="#fff" opacity=".92"/>
          <path d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z" fill="#fff" opacity=".85"/>
          <path d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z" fill="#fff"/>
        </svg>
      </div>
      <h3 style="font-size:20px;font-weight:700;margin-bottom:8px">Continue with Google</h3>
      <p style="font-size:13.5px;color:var(--muted);line-height:1.7;max-width:340px;margin:0 auto">
        <b style="color:var(--text)">Chrome</b> বা <b style="color:var(--text)">Safari</b> ব্রাউজারে খুলুন।
      </p>
    </div>
    <div style="background:#f0f9ff;border:1.5px solid #bae6fd;border-radius:12px;padding:14px;margin-top:18px;display:flex;gap:11px;align-items:flex-start">
      <span style="font-size:20px;flex:none;line-height:1">🛡️</span>
      <div style="font-size:12.5px;color:#075985;line-height:1.65"><b>${esc(appName)}</b> এর ইন-অ্যাপ ব্রাউজারে Google Login কাজ করে না।</div>
    </div>
  `;
  let foot = '';
  if (isAndroidDevice){
    const intentUrl = `intent://${cleanHost}#Intent;scheme=https;package=com.android.chrome;S.browser_fallback_url=${encodeURIComponent(url)};end`;
    foot = `<a href="${intentUrl}" class="btn btn-primary btn-block btn-lg" style="text-decoration:none;box-sizing:border-box">Chrome এ খুলুন</a>`;
  }
  foot += `<button class="btn btn-ghost btn-block" style="margin-top:8px" onclick="copyInAppLink()">🔗 লিংক কপি করুন</button>`;
  openSheet('Google দিয়ে চালিয়ে যান', body, foot);
}
window.openInAppGoogleSheet = openInAppGoogleSheet;

function copyInAppLink(){
  const url = window.location.href;
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(url).then(
      () => toast('✅ লিংক কপি হয়েছে', 'ok'),
      () => fallbackCopyLink(url)
    );
  } else fallbackCopyLink(url);
}
window.copyInAppLink = copyInAppLink;

function fallbackCopyLink(text){
  try {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    const ok = document.execCommand('copy');
    ta.remove();
    if (ok) toast('✅ লিংক কপি হয়েছে', 'ok');
    else toast('কপি ব্যর্থ', 'err');
  } catch(e){ toast('কপি ব্যর্থ', 'err'); }
}

function friendlyAuthError(e){
  const c = e && e.code;
  const m = {
    'auth/user-not-found': 'এই ইমেইলে কোনো অ্যাকাউন্ট নেই',
    'auth/wrong-password': 'পাসওয়ার্ড ভুল',
    'auth/invalid-email': 'ইমেইল সঠিক নয়',
    'auth/invalid-credential': 'ইমেইল বা পাসওয়ার্ড ভুল',
    'auth/email-already-in-use': 'এই ইমেইলে ইতিমধ্যে অ্যাকাউন্ট আছে',
    'auth/weak-password': 'পাসওয়ার্ড দুর্বল (কমপক্ষে ৬ অক্ষর)',
    'auth/too-many-requests': 'অনেকবার চেষ্টা — কিছুক্ষণ পর',
    'auth/network-request-failed': 'ইন্টারনেট সংযোগ চেক করুন'
  };
  return m[c] || (e && e.message) || 'অজানা সমস্যা';
}

function handlePendingOrderAfterAuth(){
  if (!pendingOrderAfterAuth) return;
  if (pendingOrderExpiry > 0 && Date.now() > pendingOrderExpiry){
    pendingOrderAfterAuth = false;
    pendingOrderExpiry = 0;
    return;
  }
  pendingOrderAfterAuth = false;
  pendingOrderExpiry = 0;
  if (pendingOrderResumeTimer){ clearTimeout(pendingOrderResumeTimer); pendingOrderResumeTimer = null; }
  toast('✓ লগইন সফল — অর্ডার সম্পন্ন হচ্ছে...', 'ok');
  
  try {
    const savedState = sessionStorage.getItem('pending_checkout_state');
    if (savedState) {
        S.checkout = JSON.parse(savedState);
        sessionStorage.removeItem('pending_checkout_state');
        save();
    }
  } catch(e){}

  const page = parseHash().parts[0];
  if (page !== 'checkout'){ S.checkout.step = 4; save(); go('/checkout'); }
  pendingOrderResumeTimer = setTimeout(() => {
    if (auth && auth.currentUser) placeOrder();
    else toast('⚠️ লগইন সম্পন্ন হয়নি', 'err');
    pendingOrderResumeTimer = null;
  }, 900);
}
window.handlePendingOrderAfterAuth = handlePendingOrderAfterAuth;

async function doGoogleLogin(){
  if (InAppBrowser.isInApp()){ openInAppGoogleSheet(); return; }
  if (!auth || !googleProvider) { toast('Auth সার্ভিস উপলব্ধ নেই', 'err'); return; }
  try {
    const result = await auth.signInWithPopup(googleProvider);
    await handleGoogleUserResult(result.user);
  } catch(e){
    if (e.code === 'auth/popup-blocked' || e.code === 'auth/operation-not-supported-in-this-environment' || e.code === 'auth/cancelled-popup-request'){
      try { toast('Popup বন্ধ — redirect এ যাচ্ছি...', 'info'); await auth.signInWithRedirect(googleProvider); return; }
      catch(e2){ toast(friendlyAuthError(e2), 'err'); return; }
    }
    if (e.code === 'auth/popup-closed-by-user') toast('লগইন বাতিল করা হয়েছে', 'err');
    else toast(friendlyAuthError(e), 'err');
  }
}
window.doGoogleLogin = doGoogleLogin;

async function handleGoogleUserResult(user){
  S.user = { uid: user.uid, email: user.email, displayName: user.displayName };
  if (user.photoURL && !S.profilePic) S.profilePic = user.photoURL;
  try {
    if (db) await db.collection('users').doc(user.uid).set({
      uid: user.uid, email: user.email, displayName: user.displayName,
      photoURL: user.photoURL || '',
      lastLogin: firebase.firestore.FieldValue.serverTimestamp()
    }, { merge: true });
  } catch(e){}
  save(); closeSheet(); renderDrawer();
  if (guestOrdersListener) { try { guestOrdersListener(); } catch(e){} guestOrdersListener = null; }
  startUserOrdersListener(user.uid);
  const wasPending = pendingOrderAfterAuth;
  if (!wasPending){ render(); toast('সফলভাবে গুগল লগইন হয়েছে 🎉', 'ok'); }
  handlePendingOrderAfterAuth();
}

async function doLogin(){
  const email = $('#authEmail').value.trim();
  const pass = $('#authPass').value;
  if (!email){ toast('ইমেইল দিন', 'err'); return; }
  if (pass.length < 6){ toast('পাসওয়ার্ড কমপক্ষে ৬ অক্ষর', 'err'); return; }
  if (!auth) { toast('Auth সার্ভিস উপলব্ধ নেই', 'err'); return; }
  try {
    const cred = await auth.signInWithEmailAndPassword(email, pass);
    let pic = S.profilePic;
    try {
      if (db){
        const userDoc = await db.collection('users').doc(cred.user.uid).get();
        if (userDoc.exists && userDoc.data().photoURL) pic = userDoc.data().photoURL;
      }
    } catch(e){}
    S.user = { uid: cred.user.uid, email: cred.user.email, displayName: cred.user.displayName || email.split('@')[0] };
    if (pic) S.profilePic = pic;
    save(); closeSheet(); renderDrawer();
    if (guestOrdersListener) { try { guestOrdersListener(); } catch(e){} guestOrdersListener = null; }
    startUserOrdersListener(cred.user.uid);
    const wasPending = pendingOrderAfterAuth;
    if (!wasPending){ render(); toast('সফলভাবে লগইন হয়েছে 🎉', 'ok'); }
    handlePendingOrderAfterAuth();
  } catch(e){
    toast(friendlyAuthError(e), 'err');
  }
}
window.doLogin = doLogin;

async function doSignup(){
  const name = $('#authName').value.trim();
  const email = $('#authEmail').value.trim();
  const pass = $('#authPass').value;
  if (!name){ toast('নাম লিখুন', 'err'); return; }
  if (!email){ toast('ইমেইল দিন', 'err'); return; }
  if (pass.length < 6){ toast('পাসওয়ার্ড কমপক্ষে ৬ অক্ষর', 'err'); return; }
  if (!auth) { toast('Auth সার্ভিস উপলব্ধ নেই', 'err'); return; }
  try {
    const cred = await auth.createUserWithEmailAndPassword(email, pass);
    await cred.user.updateProfile({ displayName: name });
    S.user = { uid: cred.user.uid, email: cred.user.email, displayName: name };
    try {
      if (db) await db.collection('users').doc(cred.user.uid).set({
        uid: cred.user.uid, email, displayName: name,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      }, { merge: true });
    } catch(e){}
    save(); closeSheet(); renderDrawer();
    if (guestOrdersListener) { try { guestOrdersListener(); } catch(e){} guestOrdersListener = null; }
    startUserOrdersListener(cred.user.uid);
    const wasPending = pendingOrderAfterAuth;
    if (!wasPending){ render(); toast('অ্যাকাউন্ট তৈরি হয়েছে 🎉', 'ok'); }
    handlePendingOrderAfterAuth();
  } catch(e){
    toast(friendlyAuthError(e), 'err');
  }
}
window.doSignup = doSignup;

async function doLogout(){
  if (!confirm('লগআউট করতে চান?')) return;
  try { if (auth) await auth.signOut(); } catch(e){}
  if (ordersListener){ try { ordersListener(); } catch(e){} ordersListener = null; }
  if (guestOrdersListener){ try { guestOrdersListener(); } catch(e){} guestOrdersListener = null; }
  if (chatListener){ try { chatListener(); } catch(e){} chatListener = null; }
  S.user = null; S.profilePic = null; S.orders = S.orders.filter(o => o.isGuest); save(); render(); renderDrawer();
  toast('লগআউট সম্পন্ন');
}
window.doLogout = doLogout;

