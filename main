function renderCart(){
  if (!S.cart.length){
    return `<div class="empty-state">
      <div class="es-ico">${ICO.bagEmpty}</div>
      <h3>আপনার কার্ট খালি</h3>
      <p>পছন্দের পণ্য কার্টে যোগ করে<br>শপিং শুরু করুন</p>
      <button class="btn btn-primary btn-lg" onclick="go('/home')">শপিং শুরু করুন</button>
    </div>${siteFooter()}`;
  }
  const sub = cartSubtotal();
  const disc = discountAmount();
  const ship = deliveryChargeEffective();
  const total = cartTotal();
  const addr = S.addresses[S.checkout.address];
  const isLocal = isLocalAddress(addr);

  return `
  <div style="display:flex;align-items:center;gap:10px;padding:14px 2px 12px">
    <h1 style="font-size:18px;font-weight:700">আমার কার্ট</h1>
    <span style="font-size:12.5px;color:var(--muted);margin-left:auto">${bn(cartCount())} টি পণ্য</span>
  </div>

  ${S.cart.map(item => {
    const p = getProduct(item.id);
    if (!p) return '';
    const v = item.variant || {};
    const varText = [v.color, v.size].filter(Boolean).join(' · ');
    const imgUrl = getProductImage(p);
    const thumb = imgUrl
      ? `<img src="${imgUrl}" alt="${escAttr(p.name)}" loading="lazy" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"><span class="pcard-emoji" style="display:none">${p.emoji||'📦'}</span>`
      : `<span class="pcard-emoji">${p.emoji||'📦'}</span>`;
    const encKey = encodeURIComponent(item.key);
    return `
    <div class="cart-item">
      <div class="ci-img" data-goto="/product/${escAttr(p.id)}" onclick="go(this.dataset.goto)">${thumb}</div>
      <div class="ci-body">
        <div class="ci-name" data-goto="/product/${escAttr(p.id)}" onclick="go(this.dataset.goto)">${esc(p.name)}</div>
        ${varText ? `<div class="ci-var">${esc(varText)}</div>` : ''}
        <div class="ci-foot">
          <div class="ci-price">${money(p.price * item.qty)}</div>
          <div class="qty-mini">
            <button type="button" data-key="${escAttr(encKey)}" onclick="updateCartQty(this.dataset.key,-1)" aria-label="কমান">${ICO.minus}</button>
            <span>${bn(item.qty)}</span>
            <button type="button" data-key="${escAttr(encKey)}" onclick="updateCartQty(this.dataset.key,1)" aria-label="বাড়ান">${ICO.plus}</button>
          </div>
        </div>
      </div>
      <button type="button" class="ci-remove" data-key="${escAttr(encKey)}" onclick="removeFromCart(this.dataset.key)" aria-label="সরান">${ICO.x}</button>
    </div>`;
  }).join('')}

  <div class="card card-pad" style="margin-top:12px">
    <div style="font-size:14px;font-weight:700;margin-bottom:8px">🎟️ কুপন কোড</div>
    ${S.coupon ? `
      <div style="display:flex;align-items:center;justify-content:space-between;background:var(--surface-2);padding:10px 13px;border-radius:10px;border:1px solid var(--border)">
        <div>
          <div style="font-weight:700;color:var(--primary);font-size:14px">${esc(S.coupon)}</div>
          <div style="font-size:11.5px;color:var(--muted)">${esc(COUPONS[S.coupon]?.label||'')} প্রয়োগ করা হয়েছে</div>
        </div>
        <button class="btn btn-sm btn-ghost" onclick="removeCoupon()">সরান</button>
      </div>` : `
      <div class="coupon-box">
        <input class="input" id="couponInput" placeholder="কুপন কোড" style="text-transform:uppercase">
        <button class="btn btn-dark" onclick="applyCoupon()">প্রয়োগ</button>
      </div>
      ${Object.keys(COUPONS).length ? `<div style="display:flex;flex-wrap:wrap">
        ${Object.entries(COUPONS).map(([code,c])=>`<button class="coupon-chip" data-code="${escAttr(code)}" onclick="quickCoupon(this.dataset.code)">🎟️ ${esc(code)} · ${esc(c.label||'')}</button>`).join('')}
      </div>` : ''}`}
  </div>

  <div class="card card-pad" style="margin-top:12px">
    <div style="font-size:15px;font-weight:700;margin-bottom:10px">অর্ডার সামারি</div>
    <div class="summary-row"><span>সাবটোটাল (${bn(cartCount())} আইটেম)</span><span class="val">${money(sub)}</span></div>
    ${disc > 0 ? `<div class="summary-row"><span>কুপন ছাড়</span><span class="val" style="color:var(--success)">− ${money(disc)}</span></div>` : ''}
    <div class="summary-row"><span>ডেলিভারি চার্জ</span><span class="val">${ship === 0 ? `<span style="color:var(--success)">ফ্রি${isLocal?' (লোকাল)':''}</span>` : money(ship)}</span></div>
    <div class="summary-row total"><span>সর্বমোট</span><span class="val">${money(total)}</span></div>
    <button class="btn btn-primary btn-block btn-lg" style="margin-top:14px" onclick="startCheckout()">চেকআউট · ${money(total)}</button>
    <button class="btn btn-ghost btn-block" style="margin-top:8px" onclick="go('/home')">আরও শপিং করুন</button>
  </div>
  ${siteFooter()}`;
}

function applyCoupon(){
  const code = ($('#couponInput')?.value||'').trim().toUpperCase();
  if (!code){ toast('কুপন কোড লিখুন', 'err'); return; }
  const c = COUPONS[code];
  if (!c){ toast('কুপন সঠিক নয়', 'err'); return; }
  if (c.expiresAt && Date.now() > new Date(c.expiresAt).getTime()){ toast('❌ কুপনের মেয়াদ শেষ', 'err'); return; }
  if (c.maxUses && c.usedCount >= c.maxUses){ toast('❌ কুপনের ব্যবহার সীমা শেষ', 'err'); return; }
  if (cartSubtotal() < c.min){ toast(`ন্যূনতম ${money(c.min)} অর্ডার প্রয়োজন`, 'err'); return; }
  S.coupon = code; save(); render();
  toast('কুপন প্রয়োগ হয়েছে: ' + code, 'ok');
}
function quickCoupon(code){
  const c = COUPONS[code];
  if (!c) return;
  if (c.expiresAt && Date.now() > new Date(c.expiresAt).getTime()){ toast('❌ কুপনের মেয়াদ শেষ', 'err'); return; }
  if (c.maxUses && c.usedCount >= c.maxUses){ toast('❌ কুপনের ব্যবহার সীমা শেষ', 'err'); return; }
  S.coupon = code; save(); render(); toast('কুপন প্রয়োগ হয়েছে: ' + code, 'ok');
}
function removeCoupon(){ S.coupon = null; save(); render(); toast('কুপন সরানো হয়েছে'); }
window.applyCoupon = applyCoupon; window.quickCoupon = quickCoupon; window.removeCoupon = removeCoupon;

function startCheckout(){
  if (!S.cart.length){ toast('কার্ট খালি', 'err'); return; }
  S.checkout.step = 1;
  save();
  go('/checkout');
}
window.startCheckout = startCheckout;

/* ==========================================================================
   💳 CHECKOUT
   ========================================================================== */
function renderCheckout(){
  if (!S.cart.length){
    return `<div class="empty-state"><div class="es-ico">${ICO.bagEmpty}</div><h3>কার্ট খালি</h3><p>চেকআউটের জন্য পণ্য যোগ করুন</p><button class="btn btn-primary" onclick="go('/home')">শপিং করুন</button></div>`;
  }
  const step = S.checkout.step || 1;
  const steps = ['ঠিকানা', 'ডেলিভারি', 'পেমেন্ট', 'নিশ্চিত'];

  const stepperHtml = `
  <div class="stepper">
    ${steps.map((label,i)=>{
      const n = i + 1;
      const cls = n < step ? 'done' : n === step ? 'active' : '';
      return `<div class="step ${cls}">
        <div class="st-circle">${n < step ? ICO.check : bn(n)}</div>
        <span>${label}</span>
      </div>`;
    }).join('')}
  </div>`;

  let content = '';
  const addr = S.addresses[S.checkout.address];
  const isLocalAddr = isLocalAddress(addr);
  const isGuest = !auth || !auth.currentUser;

  if (step > 1 && (S.checkout.address == null || !S.addresses[S.checkout.address]) && !isGuest){
    S.checkout.step = 1;
    save();
    return `
      <div style="display:flex;align-items:center;gap:10px;padding:14px 2px 12px">
        <button class="icon-btn" style="width:36px;height:36px;flex:0 0 36px" onclick="history.back()">${ICO.arrowL}</button>
        <h1 style="font-size:17px;font-weight:700">চেকআউট</h1>
      </div>
      <div class="notice err"><span class="n-ico">${ICO.info}</span><span>প্রথমে ডেলিভারি ঠিকানা নির্বাচন করুন।</span></div>`;
  }

  if (step === 1){
    const addrs = S.addresses.filter(a => a && a.district && a.thana && a.address);
    const guestPhone = (S.checkout.guestPhone || '').trim();
    const guestName = (S.checkout.guestName || '').trim();

    content = `
      ${isGuest && isGuestCheckoutEnabled() ? `
        <div class="guest-notice">
          <div class="gn-ic">${ICO.user}</div>
          <div class="gn-txt">
            <b>লগইন ছাড়াই অর্ডার করুন</b>
            শুধু নাম ও ফোন নাম্বার দিলেই হবে — তবে <b style="color:#dc2626">সম্পূর্ণ ঠিকানা দেওয়া বাধ্যতামূলক</b>।
            <div class="gn-benefits">
              <span class="gn-feat">📦 অর্ডার হিস্টোরি সেভ</span>
              <span class="gn-feat">💬 প্রায়োরিটি সাপোর্ট</span>
              <span class="gn-feat">⚡ দ্রুত চেকআউট</span>
            </div>
          </div>
        </div>
        <div class="card card-pad" style="margin-bottom:12px">
          <div style="font-size:15px;font-weight:700;margin-bottom:12px">👤 গেস্ট তথ্য</div>
          <div class="field">
            <label>আপনার নাম <span class="req">*</span></label>
            <input class="input" id="guestName" placeholder="পুরো নাম" value="${escAttr(guestName)}">
          </div>
          <div class="field" style="margin-bottom:0">
            <label>মোবাইল নম্বর <span class="req">*</span></label>
            <input class="input" id="guestPhone" type="tel" placeholder="01XXXXXXXXX" maxlength="11" value="${escAttr(guestPhone)}">
            <div style="font-size:11px;color:var(--muted);margin-top:5px">💡 এই নাম্বার দিয়ে order track করতে পারবেন</div>
          </div>
        </div>
      ` : ''}

      <div class="card card-pad">
        <div style="font-size:15px;font-weight:700;margin-bottom:12px">📍 ডেলিভারি ঠিকানা</div>
        ${addrs.length ? addrs.map((a) => {
          const realIdx = S.addresses.indexOf(a);
          const isActive = S.checkout.address === realIdx;
          return `
          <div class="addr-card ${isActive ? 'active' : ''}" data-idx="${realIdx}" onclick="selectAddress(Number(this.dataset.idx))">
            <div class="addr-actions">
              <button type="button" class="addr-act-btn" data-idx="${realIdx}" onclick="event.stopPropagation();editAddress(this.dataset.idx)" aria-label="এডিট">${ICO.edit}</button>
              <button type="button" class="addr-act-btn danger" data-idx="${realIdx}" onclick="event.stopPropagation();deleteAddress(this.dataset.idx)" aria-label="মুছুন">${ICO.trash}</button>
            </div>
            <div class="ac-name">${esc(a.name)} <span class="ac-tag">${esc(a.tag)}${isLocalAddress(a) ? ' · 🏍️ লোকাল' : ''}</span></div>
            <div class="ac-line">${esc(a.phone)}</div>
            <div class="ac-line">${esc(a.address)}, ${esc(a.area)}, ${esc(a.thana)}, ${esc(a.district)}</div>
          </div>`;
        }).join('') : `<div class="notice"><span class="n-ico">${ICO.info}</span><span>কোনো সেভ করা ঠিকানা নেই। নতুন ঠিকানা যোগ করুন।</span></div>`}
