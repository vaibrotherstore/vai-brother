function afterHome(){
  const track = $('#heroTrack');
  if (track){
    let idx = 0;
    const slides = track.children.length;
    const dots = $$('#heroDots i');
    if (slides > 1){
      heroTimer = setInterval(()=>{
        idx = (idx + 1) % slides;
        track.style.transform = `translateX(-${idx * 100}%)`;
        dots.forEach((d,i)=>d.classList.toggle('on', i===idx));
      }, 4200);
    }
  }
  const end = new Date(); end.setHours(23,59,59,999);
  const tick = ()=>{
    const diff = Math.max(0, end - Date.now());
    const h = Math.floor(diff/3600000);
    const m = Math.floor(diff%3600000/60000);
    const s = Math.floor(diff%60000/1000);
    const pad = n => String(n).padStart(2,'0');
    if ($('#cdH')) $('#cdH').textContent = pad(h);
    if ($('#cdM')) $('#cdM').textContent = pad(m);
    if ($('#cdS')) $('#cdS').textContent = pad(s);
  };
  if ($('#flashCd')){ tick(); cdTimer = setInterval(tick, 1000); }
}

function feedbackForm(){
  return `
  <section class="feedback-card">
    <h3>${ICO.message} আপনার মতামত জানান</h3>
    <p>আপনার পরামর্শ, অভিযোগ বা যেকোনো সমস্যা আমাদের জানান — আমরা দ্রুত সমাধান করব।</p>
    <form class="fb-form" onsubmit="event.preventDefault();submitFeedback(event);">
      <input type="text" id="fbName" placeholder="আপনার নাম" value="${escAttr(S.user?.displayName || '')}">
      <input type="tel" id="fbPhone" placeholder="মোবাইল নম্বর (অপশনাল)" value="${escAttr(S.addresses[0]?.phone || '')}">
      <select id="fbType">
        <option value="পরামর্শ">💡 পরামর্শ</option>
        <option value="অভিযোগ">⚠️ অভিযোগ</option>
        <option value="প্রশ্ন">❓ প্রশ্ন</option>
        <option value="প্রশংসা">🌟 প্রশংসা</option>
        <option value="অন্যান্য">📝 অন্যান্য</option>
      </select>
      <textarea id="fbMessage" placeholder="আপনার বিস্তারিত লিখুন..." rows="4" required></textarea>
      <button type="submit" class="fb-submit">📩 আমাদের পাঠান</button>
    </form>
  </section>`;
}

async function submitFeedback(ev){
  const name = ($('#fbName')?.value || '').trim() || 'অতিথি';
  const phone = ($('#fbPhone')?.value || '').trim();
  const type = $('#fbType')?.value || 'পরামর্শ';
  const message = ($('#fbMessage')?.value || '').trim();
  if (message.length < 5){ toast('অন্তত ৫ অক্ষর লিখুন', 'err'); return; }

  const feedback = {
    name, phone, type, message,
    userEmail: S.user?.email || '',
    userId: S.user?.uid || 'guest',
    pageUrl: location.href
  };
  const btn = ev?.target?.querySelector('button[type="submit"]') || ev?.submitter;
  if (btn){ btn.disabled = true; btn.textContent = '⏳ পাঠানো হচ্ছে...'; }
  const res = await FB.sendFeedback(feedback);
  if (btn){ btn.disabled = false; btn.textContent = '📩 আমাদের পাঠান'; }
  if (res.ok){
    toast('আপনার মতামত পাঠানো হয়েছে — ধন্যবাদ! 🙏', 'ok');
    $('#fbMessage').value = '';
  } else {
    toast('দুঃখিত, পাঠানো যায়নি — ইন্টারনেট চেক করুন', 'err');
  }
}
window.submitFeedback = submitFeedback;

