/* ==========================================================================
   🚀 LOAD FROM FIRESTORE
   ========================================================================== */
async function loadFromFirestore(){
  try {
    const productsSnap = await db.collection('products').get();
    const products = [];
    productsSnap.forEach(doc => {
      const data = doc.data();
      products.push({
        id: doc.id,
        ...data,
        createdAt: data.createdAt?.toMillis ? data.createdAt.toMillis() : (typeof data.createdAt === 'number' ? data.createdAt : 0)
      });
    });
    products.sort((a,b)=>(b.createdAt || 0) - (a.createdAt || 0));
    ALL_PRODUCTS = products;
    rebuildFuseIndex();

    try {
      const bannersSnap = await db.collection('banners').get();
      HERO_BANNERS = [];
      VIDEO_BANNERS = [];
      bannersSnap.forEach(doc => {
        const d = doc.data();
        if (d.video) VIDEO_BANNERS.push({ id: doc.id, ...d });
        else HERO_BANNERS.push({ id: doc.id, ...d });
      });
      HERO_BANNERS.sort((a,b)=>(a.order || 0) - (b.order || 0));
      VIDEO_BANNERS.sort((a,b)=>(a.order || 0) - (b.order || 0));
    } catch(e){ HERO_BANNERS = []; VIDEO_BANNERS = []; }

    try {
      const catSnap = await db.collection('categories').get();
      const remoteCats = [];
      catSnap.forEach(doc => {
        const d = doc.data();
        if (d.name && d.name !== 'সব' && !remoteCats.find(c => c.id === doc.id)){
          remoteCats.push({ id: doc.id, name: d.name, order: d.order ?? 99, image: d.image || '', emoji: d.emoji || '📦', color: d.color || '#f5f5f5' });
        }
      });
      remoteCats.sort((a,b) => (a.order ?? 99) - (b.order ?? 99));
      ALL_CATEGORIES = remoteCats;
    } catch(e){ ALL_CATEGORIES = []; }

    try {
      const setSnap = await db.collection('settings').doc('store').get();
      if (setSnap.exists) settings = Object.assign({}, DEFAULT_SETTINGS, setSnap.data());
      applySettings();
      try { localStorage.setItem('shopbd_settings', JSON.stringify(settings)); } catch(e){}
    } catch(e){ console.warn('[Settings] load error:', e); }

    try {
      const couponSnap = await db.collection('coupons').get();
      COUPONS = {};
      couponSnap.forEach(doc => { COUPONS[doc.id] = doc.data(); });
    } catch(e){ COUPONS = {}; }

  } catch(err){
    console.error('[Firestore] load error:', err);
    try {
      const cached = JSON.parse(localStorage.getItem('shopbd_settings') || 'null');
      if (cached){ settings = Object.assign({}, DEFAULT_SETTINGS, cached); applySettings(); }
    } catch(e){}
  } finally {
    const loader = $('#loadingOverlay');
    if (loader) setTimeout(()=>loader.classList.add('hide'), 300);
    renderDrawer();
  }
}

let productListenerDebounce;
function startProductListener(){
  if (productListener){ try { productListener(); } catch(e){} productListener = null; }
  if (!db) return;
  try {
    productListener = db.collection('products').onSnapshot(snap => {
      const products = [];
      snap.forEach(doc => {
        const data = doc.data();
        products.push({
          id: doc.id,
          ...data,
          createdAt: data.createdAt?.toMillis ? data.createdAt.toMillis() : (typeof data.createdAt === 'number' ? data.createdAt : 0)
        });
      });
      products.sort((a,b)=>(b.createdAt || 0) - (a.createdAt || 0));
      ALL_PRODUCTS = products;
      
      clearTimeout(productListenerDebounce);
      productListenerDebounce = setTimeout(() => {
        rebuildFuseIndex();
        const page = parseHash().parts[0];
        if (['home','category','search'].includes(page)) render();
      }, 500);
    }, err => console.warn('[Products] realtime error:', err));
  } catch(e){ console.warn('[Products] start error:', e); }
}

function startSettingsListener(){
  if (settingsListener){ try { settingsListener(); } catch(e){} settingsListener = null; }
  if (!db) return;
  try {
    settingsListener = db.collection('settings').doc('store').onSnapshot(snap => {
      if (snap.exists){
        settings = Object.assign({}, DEFAULT_SETTINGS, snap.data());
        applySettings();
        const page = parseHash().parts[0];
        if (['home','checkout','cart'].includes(page)) render();
      }
    }, err => console.warn('[Settings] listener error:', err));
  } catch(e){}
}

function startUserOrdersListener(uid){
  if (ordersListener){ try { ordersListener(); } catch(e){} ordersListener = null; }
  if (!db || !uid) return;
  try {
    ordersListener = db.collection('orders')
      .where('userId', '==', uid)
      .onSnapshot(snap => {
        const arr = [];
        snap.forEach(doc => {
          const d = doc.data();
          arr.push({
            ...d,
            id: doc.id,
            createdAt: d.createdAt?.toMillis ? d.createdAt.toMillis() : (typeof d.createdAt === 'number' ? d.createdAt : Date.now()),
            updatedAt: d.updatedAt?.toMillis ? d.updatedAt.toMillis() : (typeof d.updatedAt === 'number' ? d.updatedAt : Date.now())
          });
        });
        arr.sort((a,b) => (b.createdAt || 0) - (a.createdAt || 0));
        const serverIds = new Set(arr.map(o => o.id));
        S._serverOrderIds = [...new Set([...S._serverOrderIds, ...serverIds])];
        const localOnly = S.orders.filter(o => !serverIds.has(o.id) && !S._serverOrderIds.includes(o.id));
        S.orders = [...arr, ...localOnly].sort((a,b) => (b.createdAt || 0) - (a.createdAt || 0));
        const deliveredIds = [];
        arr.forEach(o => {
          if (o.status === 'delivered') (o.items || []).forEach(it => deliveredIds.push(it.id));
        });
        if (deliveredIds.length) S.paidProductIds = [...new Set([...S.paidProductIds, ...deliveredIds])];
        save();
        arr.forEach(o => {
          const prev = prevOrderStatusMap[o.id];
          if (prev && prev !== o.status){
            const label = {
              pending:'⏳ পেন্ডিং', confirmed:'✓ কনফার্মড',
              processing:'⚙️ প্রসেসিং', shipped:'🚚 শিপড',
              out:'🛵 ডেলিভারিতে', delivered:'📬 ডেলিভার্ড',
              cancelled:'❌ বাতিল'
            }[o.status] || o.status;
            toast(`অর্ডার ${o.id}: ${label}`, o.status === 'cancelled' ? 'err' : 'ok');
          }
          prevOrderStatusMap[o.id] = o.status;
        });
        const page = parseHash().parts[0];
        if (['orders','order','success','account'].includes(page)) render();
      }, err => console.warn('[UserOrders] listener error:', err));
  } catch(e){ console.warn('[UserOrders] start error:', e); }
}

/* ==========================================================================
   🚀 INIT
   ========================================================================== */
async function init(){
  FB.init();
  applySettings();

  try {
    if (sessionStorage.getItem('pending_order_after_auth') === '1'){
      sessionStorage.removeItem('pending_order_after_auth');
      pendingOrderAfterAuth = true;
      pendingOrderExpiry = Date.now() + 5 * 60 * 1000;
    }
  } catch(e){}

  setTimeout(() => {
    const loader = $('#loadingOverlay');
    if (loader && !loader.classList.contains('hide')) loader.classList.add('hide');
  }, 4500);

  if (auth){
    try {
      const redirectResult = await auth.getRedirectResult();
      if (redirectResult && redirectResult.user) await handleGoogleUserResult(redirectResult.user);
    } catch(e){ console.warn('[Redirect Result]', e); }

    auth.onAuthStateChanged(async user => {
      if (user){
        S.user = { uid: user.uid, email: user.email, displayName: user.displayName || (user.email||'').split('@')[0] };
        try {
          if (db){
            const doc = await db.collection('users').doc(user.uid).get();
            if (doc.exists && doc.data().photoURL) S.profilePic = doc.data().photoURL;
          }
        } catch(e){}
        save();
        renderDrawer();
        if (guestOrdersListener) { try { guestOrdersListener(); } catch(e){} guestOrdersListener = null; }
        startUserOrdersListener(user.uid);
      } else {
        S.user = null;
        S.profilePic = null;
        S.orders = S.orders.filter(o => o.isGuest);
        save();
        render();
        renderDrawer();
        if (ordersListener){ try { ordersListener(); } catch(e){} ordersListener = null; }
        prevOrderStatusMap = {};
      }
    });
  }

  if (db){
    await loadFromFirestore();
    startProductListener();
    startSettingsListener();
  } else {
    const loader = $('#loadingOverlay');
    if (loader) setTimeout(()=>loader.classList.add('hide'), 300);
  }

  const guestPhone = getPersistentGuestPhone()
                  || S.orders[0]?.phone
                  || S.checkout.guestPhone
                  || S.chatPhone
                  || (S.addresses.find(a => a?.phone)?.phone);
  if (guestPhone && !S.user){
    await loadGuestOrdersFromFirestore(guestPhone);
    startGuestOrdersListener(guestPhone);
    _guestOrdersLoaded = true;
    _guestOrdersLoadedPhone = guestPhone;
  }

  render();
  renderDrawer();

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape'){ closeAll(); closeLightbox(); closeVideoModal(); }
  });

  console.info('%c🚀 ' + brandTitle() + ' v9.0','color:#1a1a1a;font-weight:bold;font-size:14px', '✅ Privacy Policy + Credit added!');
}

window.addEventListener('load', init);

