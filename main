/* ==========================================================================
   🔥 FIREBASE SERVICE
   ========================================================================== */
const FB = {
  enabled: false, app: null, auth: null, db: null,
  init(){
    if(!db){ console.warn('[FB] Firestore unavailable'); return; }
    this.app = firebase.app(); this.auth = auth; this.db = db;
    this.enabled = true;
  },
  async getNextOrderId(){
    if(!this.enabled) return '#' + Date.now().toString().slice(-6);
    try {
      const counterRef = this.db.collection('meta').doc('orderCounter');
      let nextId = 1001;
      await this.db.runTransaction(async (t)=>{
        const doc = await t.get(counterRef);
        if (doc.exists && typeof doc.data().value === 'number') nextId = doc.data().value + 1;
        t.set(counterRef, { value: nextId, updatedAt: Date.now() }, { merge: true });
      });
      return '#' + nextId;
    } catch(e){
      console.error('[FB] getNextOrderId error:', e);
      return '#' + Date.now().toString().slice(-6);
    }
  },
  async placeOrder(order){
    if(!this.enabled) return { id: order.id, offline: true };
    try {
      const orderId = order.id;
      let serverSubtotal = 0;
      const verifiedItems = [];
      for (const it of (order.items || [])){
        const pRef = this.db.collection('products').doc(it.id);
        const pDoc = await pRef.get();
        if (!pDoc.exists){ throw new Error(`"${it.name}" আর নেই`); }
        const data = pDoc.data();
        const serverPrice = Number(data.price || 0);
        const qty = Number(it.qty || 1);
        serverSubtotal += serverPrice * qty;
        verifiedItems.push({ ...it, price: serverPrice, qty });
      }
      order.items = verifiedItems;
      order.subtotal = serverSubtotal;

      let serverDiscount = 0;
      if (order.coupon){
        try {
          const cSnap = await this.db.collection('coupons').doc(String(order.coupon).toUpperCase()).get();
          if (cSnap.exists){
            const c = cSnap.data();
            const exp = c.expiresAt ? (typeof c.expiresAt === 'string' ? new Date(c.expiresAt).getTime() : c.expiresAt) : null;
            const valid = !exp || Date.now() <= exp;
            const usesOK = !c.maxUses || (c.usedCount || 0) < c.maxUses;
            const minOK = !c.min || serverSubtotal >= c.min;
            if (valid && usesOK && minOK){
              if (c.type === 'percent') serverDiscount = Math.floor(serverSubtotal * c.value / 100);
              else if (c.type === 'flat') serverDiscount = Math.min(c.value, serverSubtotal);
            }
          }
        } catch(e){ console.warn('[FB] coupon validation:', e); }
      }
      order.discount = Math.max(0, Math.min(serverDiscount, serverSubtotal));

      let serverDelivery = 0;
      if (!order.isLocal){
        try {
          const sSnap = await this.db.collection('settings').doc('store').get();
          const s = sSnap.exists ? sSnap.data() : {};
          const baseCharge = Number(s.deliveryCharge || 130);
          const freeMin = Number(s.freeDeliveryMin || 2000);
          if (freeMin > 0 && serverSubtotal >= freeMin) serverDelivery = 0;
          else serverDelivery = baseCharge;
        } catch(e){ serverDelivery = 130; }
      }
      order.delivery = serverDelivery;
      order.total = Math.max(0, serverSubtotal - order.discount + serverDelivery);

      await this.db.runTransaction(async (t) => {
        const reads = [];
        for (const it of (order.items || [])){
          const pRef = this.db.collection('products').doc(it.id);
          const pDoc = await t.get(pRef);
          reads.push({ ref: pRef, doc: pDoc, it });
        }
        for (const r of reads){
          if (!r.doc.exists) throw new Error(`"${r.it.name}" আর নেই`);
          const curStock = Number(r.doc.data().stock || 0);
          if (curStock < r.it.qty) throw new Error(`"${r.it.name}" এর স্টক শেষ (মাত্র ${curStock} পিস আছে)`);
        }
        for (const r of reads){
          t.update(r.ref, {
            stock: firebase.firestore.FieldValue.increment(-r.it.qty),
            sold: firebase.firestore.FieldValue.increment(r.it.qty),
            updatedAt: Date.now()
          });
        }
        t.set(this.db.collection('orders').doc(orderId), {
          ...order, id: orderId,
          createdAt: firebase.firestore.FieldValue.serverTimestamp(),
          updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        });
      });

      if (order.coupon) {
        try {
            const cRef = this.db.collection('coupons').doc(String(order.coupon).toUpperCase());
            await cRef.update({ usedCount: firebase.firestore.FieldValue.increment(1) });
        } catch (e) { console.warn('Coupon update error', e); }
      }

      return { id: orderId };
    } catch(e){ console.error('[FB] placeOrder error:', e); throw e; }
  },
  async cancelOrder(orderId){
    if(!this.enabled) return false;
    try {
      const docRef = this.db.collection('orders').doc(orderId);
      const snap = await docRef.get();
      if(!snap.exists) return false;
      const order = snap.data();
      if(order.status !== 'pending' && order.status !== 'confirmed') return false;
      await docRef.update({
        status: 'cancelled',
        cancelledBy: 'customer',
        cancelledAt: firebase.firestore.FieldValue.serverTimestamp(),
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      });
      for (const it of (order.items || [])){
        try {
          await this.db.collection('products').doc(it.id).update({
            stock: firebase.firestore.FieldValue.increment(it.qty),
            sold: firebase.firestore.FieldValue.increment(-it.qty),
            updatedAt: Date.now()
          });
        } catch(e){}
      }
      return true;
    } catch(e){ return false; }
  },
  async addReview(productId, review){
    if(!this.enabled) return { ok: false, error: 'Firestore unavailable' };
    try {
      await this.db.collection('products').doc(productId).collection('reviews').add({
        ...review,
        createdAt: firebase.firestore.FieldValue.serverTimestamp(),
        createdAtMs: Date.now()
      });
      return { ok: true };
    } catch(e){
      console.warn('Review save error:', e);
      return { ok: false, error: e.message || 'Save failed' };
    }
  },
  async sendFeedback(feedback){
    if(!this.enabled) return { ok: false };
    try {
      await this.db.collection('feedback').add({
        ...feedback,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
      return { ok: true };
    } catch(e){
      console.warn('Feedback save error:', e);
      return { ok: false };
    }
  },
  async addProductQuestion(productId, question){
    if(!this.enabled) return null;
    try {
      const ref = await this.db.collection('products').doc(productId)
        .collection('questions').add({
          ...question,
          createdAt: firebase.firestore.FieldValue.serverTimestamp(),
          createdAtMs: Date.now(),
          answers: []
        });
      return ref.id;
    } catch(e){ console.warn('Q&A error:', e); return null; }
  },
  async loadProductQuestions(productId){
    if(!this.enabled) return [];
    try {
      const snap = await this.db.collection('products').doc(productId)
        .collection('questions').orderBy('createdAtMs', 'desc').limit(50).get();
      const arr = [];
      snap.forEach(d => arr.push({ id: d.id, ...d.data() }));
      return arr;
    } catch(e){ return []; }
  },
  async notifyOrder(order){
    if(!this.enabled) return;
    try {
      await this.db.collection('notifications').add({
        type: 'order_placed',
        orderId: order.id,
        phone: order.phone,
        email: order.userEmail || '',
        channel: 'whatsapp',
        status: 'pending',
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
    } catch(e){}
  },
  async getDeliveredProducts(userId, phone){
    if(!this.enabled) return [];
    try {
      const results = [];
      if (userId && userId !== 'guest'){
        const snap = await this.db.collection('orders').where('userId', '==', userId).where('status', '==', 'delivered').get();
        snap.forEach(d => {
          const o = d.data();
          (o.items || []).forEach(it => results.push(it.id));
        });
      }
      if (phone){
        const snap2 = await this.db.collection('orders').where('phone', '==', phone).where('status', '==', 'delivered').get();
        snap2.forEach(d => {
          const o = d.data();
          (o.items || []).forEach(it => results.push(it.id));
        });
      }
      return [...new Set(results)];
    } catch(e){ return []; }
  },
  async loadGuestOrders(phone){
    if(!this.enabled || !phone) return [];
    try {
      const snap = await this.db.collection('orders').where('phone', '==', phone).get();
      const arr = [];
      snap.forEach(doc => {
        const d = doc.data();
        arr.push({
          ...d,
          id: doc.id,
          createdAt: d.createdAt?.toMillis ? d.createdAt.toMillis() : (typeof d.createdAt === 'number' ? d.createdAt : Date.now()),
          updatedAt: d.updatedAt?.toMillis ? d.updatedAt.toMillis() : (typeof d.updatedAt === 'number' ? d.updatedAt : Date.now())
        });
      });
      arr.sort((a,b) => (b.createdAt || 0) - (a.createdAt || 0));
      return arr;
    } catch(e){ console.warn('Load guest orders error:', e); return []; }
  },
  async uploadToCloudinary(file, resourceType='image', onProgress){
    const cloudName = cloudinaryCloudName();
    const preset = cloudinaryUploadPreset();
    if (!cloudName || !preset) throw new Error('Cloudinary not configured');
    const fd = new FormData();
    fd.append('file', file);
    fd.append('upload_preset', preset);
    const url = `https://api.cloudinary.com/v1_1/${cloudName}/${resourceType}/upload`;
    return new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open('POST', url);
      xhr.upload.onprogress = (e) => {
        if (e.lengthComputable && onProgress) onProgress(Math.round((e.loaded/e.total) * 100));
      };
      xhr.onload = () => {
        try {
          const data = JSON.parse(xhr.responseText);
          if (data.secure_url) resolve(data.secure_url);
          else reject(new Error(data.error?.message || 'Upload failed'));
        } catch(e){ reject(e); }
      };
      xhr.onerror = () => reject(new Error('Network error'));
      xhr.send(fd);
    });
  }
};

/* ==========================================================================
   🛒 CART
   ========================================================================== */
function cartCount(){ return S.cart.reduce((n,i)=>n+i.qty, 0); }
function cartSubtotal(){
  return S.cart.reduce((sum, item)=>{
    const p = getProduct(item.id);
    return sum + (p ? p.price * item.qty : 0);
  }, 0);
}
function isLocalAddress(addr){
  if (!addr) return false;
  const dist = (addr.district || '').trim();
  const th = (addr.thana || '').trim();
  return dist === localDistrict() && th === localThana();
}
function deliveryChargeEffective(){
  const addr = S.addresses[S.checkout.address];
  if (isLocalAddress(addr)) return 0;
  const sub = cartSubtotal();
  if (sub === 0) return 0;
  const freeMin = Number(settings.freeDeliveryMin || 2000);
  if (freeMin > 0 && sub >= freeMin) return 0;
  return deliveryCharge();
}
function discountAmount(){
  const sub = cartSubtotal();
  const code = S.coupon ? S.coupon.toUpperCase() : null;
  if (!code || !COUPONS[code]) return 0;
  const c = COUPONS[code];
  if (c.expiresAt && Date.now() > new Date(c.expiresAt).getTime()) return 0;
  if (c.maxUses && c.usedCount >= c.maxUses) return 0;
  if (sub < c.min) return 0;
  if (c.type === 'percent') return Math.floor(sub * c.value / 100);
  if (c.type === 'flat') return Math.min(c.value, sub);
  if (c.type === 'ship') return deliveryChargeEffective();
  return 0;
}
function cartTotal(){
  return Math.max(0, cartSubtotal() - discountAmount() + deliveryChargeEffective());
}
function addToCart(id, qty=1, variant={}){
  const p = getProduct(id);
  if (!p) return;
  const stock = Number(p.stock) || 0;
  if (stock <= 0){ toast('দুঃখিত, পণ্যটি স্টকে নেই', 'err'); return; }
  const sortedVariant = Object.keys(variant).sort().reduce((acc, k) => { acc[k] = variant[k]; return acc; }, {});
  const key = id + '::' + JSON.stringify(sortedVariant);
  const found = S.cart.find(i => i.key === key);
  if (found) found.qty = Math.min(found.qty + qty, stock);
  else S.cart.push({ key, id, qty: Math.min(qty, stock), variant });
  save();
  toast('কার্টে যোগ হয়েছে', 'ok');
  if (parseHash().parts[0] === 'cart') render();
}
function updateCartQty(encodedKey, delta){
  const key = safeDecode(encodedKey);
  const idx = S.cart.findIndex(i => i.key === key);
  if (idx < 0) return;
  const item = S.cart[idx];
  const p = getProduct(item.id);
  const next = item.qty + delta;
  if (next <= 0){ S.cart.splice(idx, 1); save(); render(); toast('পণ্য সরানো হয়েছে'); return; }
  const maxStock = p ? (Number(p.stock) || 0) : 0;
  if (p && next > maxStock){ toast(`স্টকে সর্বোচ্চ ${bn(maxStock)} পিস আছে`, 'err'); return; }
  item.qty = next;
  save(); render();
}
function removeFromCart(encodedKey){
  const key = safeDecode(encodedKey);
  S.cart = S.cart.filter(i => i.key !== key);
  save(); render();
  toast('কার্ট থেকে সরানো হয়েছে');
}
function toggleWish(id){
  const i = S.wishlist.indexOf(id);
  if (i > -1){ S.wishlist.splice(i, 1); toast('উইশলিস্ট থেকে সরানো হয়েছে'); }
  else { S.wishlist.push(id); toast('উইশলিস্টে যোগ হয়েছে', 'ok'); }
  save(); render();
}
function toggleCompare(id){
  const i = S.compare.indexOf(id);
  if (i > -1) S.compare.splice(i, 1);
  else {
    if (S.compare.length >= 3){ toast('সর্বোচ্চ ৩টি পণ্য তুলনা করা যায়', 'err'); return; }
    S.compare.push(id);
    toast('তুলনার জন্য যোগ হয়েছে', 'ok');
  }
  save(); render();
}

/* ==========================================================================
   🧭 ROUTER
   ========================================================================== */
function parseHash(){
  const raw = location.hash.replace(/^#/, '') || '/home';
  const [path, qs] = raw.split('?');
  const parts = path.split('/').filter(Boolean);
  const query = {};
  (qs||'').split('&').filter(Boolean).forEach(kv=>{
    const [k,v] = kv.split('=');
    query[safeDecode(k)] = safeDecode(v);
  });
  return { parts, query, path };
}

let heroTimer = null, cdTimer = null;

const HIDE_NAV_PAGES = ['product', 'search', 'checkout', 'success', 'order', 'return', 'about', 'support', 'chat', 'privacy'];

function render(){
  const { parts, query } = parseHash();
  const view = $('#view');
  const page = parts[0] || 'home';
  if (heroTimer){ clearInterval(heroTimer); heroTimer = null; }
  if (cdTimer){ clearInterval(cdTimer); cdTimer = null; }

  if (page !== 'product' && reviewListener){
    try { reviewListener(); } catch(e){}
    reviewListener = null;
    reviewRetryCount = 0;
  }
  if (page !== 'product' && questionsListener){
    try { questionsListener(); } catch(e){}
    questionsListener = null;
  }
  if (page !== 'chat' && chatListener){
    try { chatListener(); } catch(e){}
    chatListener = null;
  }

  document.body.classList.toggle('nav-hidden', HIDE_NAV_PAGES.includes(page));
  document.body.classList.toggle('home-active', page === 'home');

  const titles = {
    home: 'হোম',
    category: 'ক্যাটাগরি',
    product: 'পণ্য',
    cart: 'কার্ট',
    checkout: 'চেকআউট',
    orders: 'আমার অর্ডার',
    account: 'একাউন্ট',
    about: 'আমাদের সম্পর্কে',
    privacy: 'প্রাইভেসি পলিসি',
    search: 'সার্চ',
    wishlist: 'উইশলিস্ট',
    compare: 'তুলনা',
    support: 'সাপোর্ট',
    chat: 'লাইভ চ্যাট',
    return: 'রিটার্ন পলিসি'
  };
  if (page === 'product' && parts[1]) {
    const p = getProduct(parts[1]);
    document.title = (p ? p.name : 'পণ্য') + ' — ' + brandTitle();
  } else {
    document.title = (titles[page] ? titles[page] + ' — ' : '') + brandTitle();
  }

  $$('.bn-item').forEach(b => b.classList.remove('active'));
  const navMap = { home:'home', category:'category', cart:'cart', wishlist:'wishlist', account:'account', orders:'account' };
  const navKey = navMap[page];
  if (navKey) $(`.bn-item[data-nav="${navKey}"]`)?.classList.add('active');

  switch(page){
    case 'home': view.innerHTML = renderHome(); afterHome(); break;
    case 'category': view.innerHTML = renderCategory(parts[1]||'all'); break;
    case 'product': view.innerHTML = renderProduct(parts[1]); afterProduct(parts[1]); break;
    case 'search': view.innerHTML = renderSearchPage(query.q||''); break;
    case 'cart': view.innerHTML = renderCart(); break;
    case 'checkout': view.innerHTML = renderCheckout(); afterCheckout(); break;
    case 'success': view.innerHTML = renderSuccess(parts[1]); break;
    case 'orders': view.innerHTML = renderOrders(); afterOrders(); break;
    case 'order': view.innerHTML = renderOrderDetail(parts[1]); break;
    case 'wishlist': view.innerHTML = renderWishlist(); break;
    case 'compare': view.innerHTML = renderCompare(); break;
    case 'account': view.innerHTML = renderAccount(); break;
    case 'support': view.innerHTML = renderSupport(); break;
    case 'about': view.innerHTML = renderAbout(); break;
    case 'return': view.innerHTML = renderReturnRules(); break;
    case 'chat': view.innerHTML = renderChatPage(); afterChatPage(); break;
    case 'privacy': view.innerHTML = renderPrivacyPolicy(); break;
    default: view.innerHTML = renderNotFound();
  }
  renderCatStrip(page, parts[1]);
  updateBadges();

  const hash = location.hash || '#/home';
  let restoreY = 0;
  if (page !== 'product') {
    const savedY = getSavedScroll(hash);
    if (typeof savedY === 'number' && savedY > 0) restoreY = savedY;
  }
  requestAnimationFrame(() => {
    requestAnimationFrame(() => { window.scrollTo(0, restoreY); });
  });
}
window.addEventListener('hashchange', render);

function renderCatStrip(page, catId){
  const strip = $('#catStrip');
  if (!strip) return;
  if (page !== 'home'){ strip.classList.add('hidden'); return; }
  strip.classList.remove('hidden');
  strip.innerHTML = `
    <button class="cat-chip active" data-goto="/category/all" onclick="go(this.dataset.goto)">সব পণ্য</button>
    ${ALL_CATEGORIES.map(c => `
      <button class="cat-chip" data-goto="/category/${escAttr(c.id || c.name)}" onclick="go(this.dataset.goto)">${esc(c.name)}</button>
    `).join('')}
  `;
}

