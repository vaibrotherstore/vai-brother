const LS_KEY = 'shopbd_state_v9';
const LS_GUEST_PHONE = 'shopbd_guest_phone';

function defaultState(){
  return {
    cart: [], wishlist: [], compare: [], orders: [],
    addresses: [], user: null, coupon: null,
    searchHistory: [], recentlyViewed: [],
    reviews: {},
    checkout: { step:1, address:null, trxId:'', paymentMethod:'bkash', guestPhone:'', guestName:'' },
    profilePic: null,
    chatPhone: null,
    returnRequests: [],
    productQuestions: {},
    reviewedProducts: [],
    paidProductIds: [],
    _serverOrderIds: []
  };
}
let S = (()=>{
  try {
    const raw = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
    const merged = Object.assign(defaultState(), raw);
    if (!merged.checkout) merged.checkout = defaultState().checkout;
    if (!merged.checkout.paymentMethod) merged.checkout.paymentMethod = 'bkash';
    if (!Array.isArray(merged._serverOrderIds)) merged._serverOrderIds = [];
    return merged;
  } catch(e){ return defaultState(); }
})();

function getPersistentGuestPhone(){
  try { return localStorage.getItem(LS_GUEST_PHONE) || ''; } catch(e){ return ''; }
}
function setPersistentGuestPhone(phone){
  try {
    if (phone) localStorage.setItem(LS_GUEST_PHONE, phone);
    else localStorage.removeItem(LS_GUEST_PHONE);
  } catch(e){}
}

function save(){
  try { localStorage.setItem(LS_KEY, JSON.stringify(S)); } catch(e){ console.warn('[save] localStorage quota exceeded'); }
  updateBadges();
}
function updateBadges(){
  const c = cartCount(), w = S.wishlist.length;
  const set = (el, val)=>{ if(!el) return; el.textContent = bn(val); el.classList.toggle('hide', val===0); };
  set($('#hdrCart'), c); set($('#navCart'), c);
  set($('#hdrWish'), w); set($('#navWish'), w);
  const dc = $('#drCartCount');
  if (dc) dc.textContent = bn(c);
}

