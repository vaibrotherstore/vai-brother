          • পণ্য হাতে পেয়ে দিবেন: <b>${money(cartSubtotal() - discountAmount())}</b>
        </div>` : `<div style="font-size:12.5px;color:#065f46;margin-top:8px;padding:10px 12px;background:#ecfdf5;border:1px solid #86efac;border-radius:9px;line-height:1.6">
          <b>🏍️ লোকাল ডেলিভারি:</b> সম্পূর্ণ <b>${money(cartTotal())}</b> টাকা পণ্য হাতে পেয়ে পরিশোধ করবেন। কোনো অগ্রিম নেই।
        </div>`}
      </div>

      <label class="check" style="margin:12px 4px;font-size:13px;align-items:flex-start">
        <input type="checkbox" id="agreeTerms" style="margin-top:2px">
        <span>আমি <span class="policy-click" onclick="event.preventDefault();showTermsSheet()">শর্তাবলী</span> ও <span class="policy-click" onclick="event.preventDefault();showReturnPolicySheet()">রিটার্ন পলিসি</span> পড়েছি এবং সম্মত আছি</span>
      </label>`;
  }

  const backBtn = step > 1 ? `<button class="btn btn-ghost btn-block" style="margin-top:8px" onclick="checkoutBack()">‹ পেছনে যান</button>` : '';
  const nextBtn = step < 4
    ? `<button class="btn btn-primary btn-block btn-lg" onclick="checkoutNext()">পরবর্তী ধাপ ›</button>`
    : `<button class="btn btn-primary btn-block btn-lg" id="placeOrderBtn" onclick="placeOrder()">${ICO.check} অর্ডার নিশ্চিত · ${money(cartTotal())}</button>`;

  return `
  <div style="display:flex;align-items:center;gap:10px;padding:14px 2px 12px">
    <button class="icon-btn" style="width:36px;height:36px;flex:0 0 36px" onclick="history.back()">${ICO.arrowL}</button>
    <h1 style="font-size:17px;font-weight:700">চেকআউট</h1>
  </div>
  ${stepperHtml}
  ${content}
  ${nextBtn}
  ${backBtn}
  <div style="height:20px"></div>
  ${siteFooter()}`;
}

function afterCheckout(){
  const trx = $('#bkashTrx');
  if (trx) trx.addEventListener('input', ()=>{ S.checkout.trxId = trx.value; save(); });
  const gn = $('#guestName');
  if (gn) gn.addEventListener('input', ()=>{ S.checkout.guestName = gn.value; save(); });
  const gp = $('#guestPhone');
  if (gp) gp.addEventListener('input', ()=>{ S.checkout.guestPhone = gp.value; save(); });
}

function selectAddress(i){ S.checkout.address = i; save(); render(); }
window.selectAddress = selectAddress;

function selectPaymentMethod(method){
  if (method === 'nagad' && !isNagadEnabled()){ toast('নগদ পেমেন্ট এখনো চালু হয়নি', 'err'); return; }
  S.checkout.paymentMethod = method;
  save(); render();
}
window.selectPaymentMethod = selectPaymentMethod;

function copyPaymentNum(num){
  if (navigator.clipboard) navigator.clipboard.writeText(num).then(()=>toast('নাম্বার কপি হয়েছে: ' + num, 'ok'));
  else toast('নাম্বার: ' + num);
}
window.copyPaymentNum = copyPaymentNum;

function checkoutNext(){
  const step = S.checkout.step || 1;
  const isGuest = !auth || !auth.currentUser;

  if (step === 1){
    if (isGuest && isGuestCheckoutEnabled()){
      const gn = ($('#guestName')?.value || '').trim();
      const gp = ($('#guestPhone')?.value || '').trim();
      if (!gn){ toast('আপনার নাম লিখুন', 'err'); return; }
      if (!/^01[3-9]\d{8}$/.test(gp)){ toast('সঠিক ১১ ডিজিটের মোবাইল নম্বর দিন', 'err'); return; }
      S.checkout.guestName = gn;
      S.checkout.guestPhone = gp;
      setPersistentGuestPhone(gp);
      save();
    }
    const addr = S.addresses[S.checkout.address];
    if (!addr || !addr.name || !addr.phone || !addr.district || !addr.thana || !addr.area || !addr.address){
      toast('⚠️ সম্পূর্ণ ডেলিভারি ঠিকানা যোগ করুন', 'err');
      openAddressSheet();
      return;
    }
  }
  if (step === 3){
    const addr = S.addresses[S.checkout.address];
    const isLocalAddr = isLocalAddress(addr);
    if (!isLocalAddr){
      const trxInput = $('#bkashTrx');
      const trx = trxInput ? trxInput.value.trim() : (S.checkout.trxId || '');
      if (trx.length < 6){ toast('⚠️ পেমেন্ট TrxID লিখুন (কমপক্ষে ৬ অক্ষর)', 'err'); return; }
      S.checkout.trxId = trx;
      save();
    }
  }
  S.checkout.step = Math.min(4, step + 1);
  save(); render();
}
function checkoutBack(){
  S.checkout.step = Math.max(1, (S.checkout.step || 1) - 1);
  save(); render();
}
window.checkoutNext = checkoutNext; window.checkoutBack = checkoutBack;

