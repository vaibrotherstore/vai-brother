function getColorHex(name){
  if (!name) return '#cccccc';
  const trimmed = String(name).trim();
  if (COLOR_MAP[trimmed]) return COLOR_MAP[trimmed];
  const key = trimmed.toLowerCase();
  for (const [k,v] of Object.entries(COLOR_MAP)) {
    if (k.toLowerCase() === key) return v;
  }
  return '#cccccc';
}
function isLightColor(hex){
  if (!hex) return false;
  let h = String(hex).replace('#','');
  if (h.length === 3) h = h.split('').map(c => c+c).join('');
  if (h.length !== 6) return false;
  const r = parseInt(h.substring(0,2),16);
  const g = parseInt(h.substring(2,4),16);
  const b = parseInt(h.substring(4,6),16);
  const lum = (0.299*r + 0.587*g + 0.114*b) / 255;
  return lum > 0.85;
}
function normalizeColors(rawColors){
  if (!rawColors || !rawColors.length) return [];
  return rawColors.map(c => {
    if (typeof c === 'string') return { name: c, hex: getColorHex(c) };
    if (c && typeof c === 'object'){
      return {
        name: c.name || c.label || c.title || '',
        hex: c.hex || c.color || c.code || getColorHex(c.name || c.label || '')
      };
    }
    return null;
  }).filter(Boolean);
}
function getImageForColor(p, colorName){
  if (!p || !colorName) return null;
  if (p.colorImages && typeof p.colorImages === 'object'){
    if (p.colorImages[colorName]) return fixImgUrl(p.colorImages[colorName]);
    const key = Object.keys(p.colorImages).find(k => k.toLowerCase() === colorName.toLowerCase());
    if (key) return fixImgUrl(p.colorImages[key]);
  }
  if (Array.isArray(p.colors)){
    const c = p.colors.find(x => (typeof x === 'object' && x !== null && (x.name === colorName || x.label === colorName)));
    if (c && (c.image || c.img)) return fixImgUrl(c.image || c.img);
  }
  const imgs = getProductImages(p);
  const colors = normalizeColors(p.colors);
  const idx = colors.findIndex(c => c.name === colorName);
  if (idx >= 0 && imgs[idx]) return fixImgUrl(imgs[idx]);
  return null;
}

