function isPartnerEnabled(){ return settings.partnerEnabled !== false && (settings.brand2Name || '').trim().length > 0; }
function brandTitle(){
  const b1 = (settings.brandName || 'Must Look').trim();
  if (isPartnerEnabled()) return b1 + ' × ' + (settings.brand2Name || '').trim();
  return b1;
}
