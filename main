      </div>
      <div class="card card-pad" style="margin-top:12px">
        <div class="field" style="margin-bottom:8px">
          <label>অর্ডার নোট (অপশনাল)</label>
          <textarea class="textarea" id="orderNote" placeholder="যেমন: বিকেল ৫টার পরে" style="min-height:66px"></textarea>
        </div>
      </div>`;
  }

  if (step === 2){
    content = `
