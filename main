    <div style="font-size:12.5px;color:var(--muted);margin-top:3px">${bn(list.length)} টি পণ্য</div>
  </div>
  ${list.length
    ? `<div class="p-grid">${list.map(productCard).join('')}</div>`
    : `<div class="empty-state"><div class="es-ico">${ICO.search}</div><h3>কিছু পাওয়া যায়নি</h3><p>"${esc(q)}" এর জন্য কোনো পণ্য নেই।</p><button class="btn btn-primary" onclick="go('/home')">হোমে ফিরুন</button></div>`}
  ${siteFooter()}`;
}

function onSearchFocus(){ document.body.classList.add('nav-hidden'); }
function onSearchBlur(){
  setTimeout(()=>{
    const { parts } = parseHash();
    if (!HIDE_NAV_PAGES.includes(parts[0] || 'home')) document.body.classList.remove('nav-hidden');
    const box = $('#suggestBox');
    if (box && !document.activeElement.closest('.suggest')) box.classList.add('hide');
  }, 200);
}
window.onSearchFocus = onSearchFocus;
window.onSearchBlur = onSearchBlur;

let searchDebounceTimer = null;
function onSearchInput(value){
  const clearBtn = $('#sClear');
  if (clearBtn) clearBtn.classList.toggle('hide', !value);
  clearTimeout(searchDebounceTimer);
  searchDebounceTimer = setTimeout(() => doSearchInputValue(value), 200);
}
function doSearchInputValue(value){
  const box = $('#suggestBox');
  if (!value || value.trim().length < 1){
    if (S.searchHistory.length){
      box.innerHTML = `<div class="sug-head">সাম্প্রতিক সার্চ</div>
        ${S.searchHistory.slice(0,6).map(h=>`<div class="sug-item" onmousedown="event.preventDefault()" data-search="${escAttr(h)}" onclick="event.stopPropagation();doSearch(this.dataset.search)"><span style="opacity:.6">🕐</span><span>${esc(h)}</span></div>`).join('')}
        <div class="sug-item" onmousedown="event.preventDefault()" style="color:var(--danger)" onclick="event.stopPropagation();clearHistory()"><span style="opacity:.6">🗑️</span><span>হিস্টোরি মুছুন</span></div>`;
      box.classList.remove('hide');
    } else {
      box.classList.add('hide');
      box.innerHTML = '';
    }
    return;
  }
  const results = smartSearchProducts(value).slice(0, 6);
  const q = value.trim().toLowerCase();
  box.innerHTML = `
    ${results.length ? `<div class="sug-head">পণ্য</div>${results.map(p=>`
      <div class="sug-item" onmousedown="event.preventDefault()" data-pick="${escAttr(p.id)}" onclick="event.stopPropagation();pickSuggestion(this.dataset.pick)">
        <img src="${imgFor(p,0,80)}" style="width:34px;height:34px;border-radius:8px;object-fit:cover" loading="lazy" onerror="this.style.display='none'">
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${highlight(p.name, q)}</div>
          <div style="font-size:11.5px;color:var(--primary);font-weight:700">${money(p.price)}</div>
        </div>
      </div>`).join('')}` : ''}
    <div class="sug-item" onmousedown="event.preventDefault()" data-search="${escAttr(value)}" onclick="event.stopPropagation();doSearch(this.dataset.search)">
      <span style="opacity:.6">🔍</span><span>"<b>${esc(value)}</b>" এর সব ফলাফল দেখুন</span>
    </div>`;
  box.classList.remove('hide');
}
window.onSearchInput = onSearchInput;

function highlight(text, q){
  if (!q) return esc(text);
  const idx = text.toLowerCase().indexOf(q);
  if (idx < 0) return esc(text);
  return esc(text.slice(0, idx)) + '<b>' + esc(text.slice(idx, idx + q.length)) + '</b>' + esc(text.slice(idx + q.length));
}
function pickSuggestion(id){
  const box = $('#suggestBox');
  if (box) box.classList.add('hide');
  $('#searchInput')?.blur();
  go('/product/' + id);
}
window.pickSuggestion = pickSuggestion;

function doSearch(q){
  q = (q || '').trim();
  if (!q) return;
  S.searchHistory = [q, ...S.searchHistory.filter(x=>x!==q)].slice(0, 10);
  save();
  const box = $('#suggestBox');
  if (box) box.classList.add('hide');
  $('#searchInput')?.blur();
  go('/search?q=' + encodeURIComponent(q));
}
window.doSearch = doSearch;

function clearSearch(){
  const inp = $('#searchInput');
  if (inp) inp.value = '';
  const box = $('#suggestBox');
  if (box){ box.classList.add('hide'); box.innerHTML = ''; }
  const clr = $('#sClear');
  if (clr) clr.classList.add('hide');
}
window.clearSearch = clearSearch;

function clearHistory(){
  S.searchHistory = [];
  save();
  const box = $('#suggestBox');
  if (box){ box.classList.add('hide'); box.innerHTML = ''; }
  const inp = $('#searchInput');
  if (inp) inp.value = '';
  const clr = $('#sClear');
  if (clr) clr.classList.add('hide');
  toast('সার্চ হিস্টোরি মুছে ফেলা হয়েছে');
}
window.clearHistory = clearHistory;

document.addEventListener('click', e => {
  const box = $('#suggestBox');
  if (!box) return;
  if (!box.contains(e.target) && !e.target.closest('#searchInput')) box.classList.add('hide');
});

