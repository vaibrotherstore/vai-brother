function applySettings(){
  const bnEl = document.getElementById('brandName');
  if (bnEl) {
    const name = settings.brandName || 'Must Look';
    const parts = name.split(' ');
    if (parts.length > 1) {
      const last = parts.pop();
      bnEl.innerHTML = esc(parts.join(' ')) + ' <span>' + esc(last) + '</span>';
    } else bnEl.textContent = name;
  }
  const logoEl = document.getElementById('brandLogo');
  if (logoEl && settings.logo) logoEl.src = fixImgUrl(settings.logo);
  const tagEl = document.getElementById('brandTagline');
  if (tagEl) tagEl.textContent = settings.tagline || 'ONLINE SHOP';

  const bn2El = document.getElementById('brand2Name');
  if (bn2El) {
    const name2 = settings.brand2Name || 'Gen-Z Gents';
    const parts2 = name2.split(' ');
    if (parts2.length > 1) {
      const last2 = parts2.pop();
      bn2El.innerHTML = esc(parts2.join(' ')) + ' <span>' + esc(last2) + '</span>';
    } else bn2El.textContent = name2;
  }
  const l2El = document.getElementById('brand2Logo');
  if (l2El && settings.logo2) l2El.src = fixImgUrl(settings.logo2);
  const tag2El = document.getElementById('brand2Tagline');
  if (tag2El) tag2El.textContent = settings.tagline2 || 'GENTS CORNER';

  const cobrand = document.getElementById('cobrandBox');
  if (cobrand) cobrand.classList.toggle('solo', !isPartnerEnabled());

  CONFIG.store.name = settings.brandName || 'Must Look';
  CONFIG.store.deliveryCharge = deliveryCharge();
  CONFIG.store.supportPhone = settings.supportPhone || CONFIG.store.supportPhone;
  CONFIG.store.supportEmail = settings.supportEmail || CONFIG.store.supportEmail;
  CONFIG.store.whatsapp = settings.waPrimary || CONFIG.store.whatsapp;
  CONFIG.store.address = settings.address || CONFIG.store.address;
  CONFIG.store.localDistrict = localDistrict();
  CONFIG.store.localThana = localThana();

  document.title = brandTitle() + ' — অনলাইন শপিং';
}

