}
window.openSizeGuide = openSizeGuide;

/* ==========================================================================
   LIGHTBOX / VIDEO MODAL
   ========================================================================== */
let _lbImages = [];
let _lbIdx = 0;
let _lbScale = 1;
let _lbStartX = 0, _lbStartY = 0, _lbTranslate = { x:0, y:0 };

function openLightbox(idx){
  const id = parseHash().parts[1];
  const p = getProduct(id);
  if (!p) return;
  _lbImages = getProductImages(p);
  if (!_lbImages.length) return;
  _lbIdx = idx || 0;
  _lbScale = 1;
  _lbTranslate = { x:0, y:0 };
  const lb = $('#lightbox');
  const img = $('#lightboxImg');
  img.src = fixImgUrl(_lbImages[_lbIdx]);
  img.style.transform = 'scale(1) translate(0,0)';
  lb.classList.add('show');
  document.body.classList.add('no-scroll');
  attachLightboxGestures();
}
window.openLightbox = openLightbox;

function closeLightbox(){
  $('#lightbox').classList.remove('show');
  document.body.classList.remove('no-scroll');
  _lbScale = 1;
  _lbTranslate = { x:0, y:0 };
}
window.closeLightbox = closeLightbox;

function navLightbox(dir){
  if (!_lbImages.length) return;
  _lbIdx = (_lbIdx + dir + _lbImages.length) % _lbImages.length;
  _lbScale = 1;
  _lbTranslate = { x:0, y:0 };
  const img = $('#lightboxImg');
  img.src = fixImgUrl(_lbImages[_lbIdx]);
  img.style.transform = 'scale(1) translate(0,0)';
}
window.navLightbox = navLightbox;

function attachLightboxGestures(){
  const img = $('#lightboxImg');
  if (!img || img.dataset.gestures === '1') return;
  img.dataset.gestures = '1';
  let initialDist = 0;
  let initialScale = 1;
  let isDragging = false;
  let lastTap = 0;

  img.addEventListener('touchstart', e => {
    if (e.touches.length === 2){
      initialDist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      initialScale = _lbScale;
    } else if (e.touches.length === 1){
      _lbStartX = e.touches[0].clientX - _lbTranslate.x;
      _lbStartY = e.touches[0].clientY - _lbTranslate.y;
      isDragging = _lbScale > 1;
    }
  }, { passive: true });

  img.addEventListener('touchmove', e => {
    if (e.touches.length === 2){
      e.preventDefault();
      const dist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      _lbScale = Math.max(1, Math.min(5, initialScale * (dist / initialDist)));
      img.style.transform = `scale(${_lbScale}) translate(${_lbTranslate.x}px, ${_lbTranslate.y}px)`;
    } else if (e.touches.length === 1 && isDragging){
      e.preventDefault();
      _lbTranslate.x = e.touches[0].clientX - _lbStartX;
      _lbTranslate.y = e.touches[0].clientY - _lbStartY;
      img.style.transform = `scale(${_lbScale}) translate(${_lbTranslate.x}px, ${_lbTranslate.y}px)`;
    }
  }, { passive: false });

  img.addEventListener('touchend', e => {
    if (_lbScale <= 1.05){ _lbScale = 1; _lbTranslate = { x:0, y:0 }; }
    if (_lbScale > 1){
      const maxX = (img.clientWidth * (_lbScale - 1)) / 2;
      const maxY = (img.clientHeight * (_lbScale - 1)) / 2;
      _lbTranslate.x = Math.max(-maxX, Math.min(maxX, _lbTranslate.x));
      _lbTranslate.y = Math.max(-maxY, Math.min(maxY, _lbTranslate.y));
    }
    img.style.transform = `scale(${_lbScale}) translate(${_lbTranslate.x}px, ${_lbTranslate.y}px)`;
    const now = Date.now();
    if (now - lastTap < 300){
      if (_lbScale > 1){ _lbScale = 1; _lbTranslate = { x:0, y:0 }; }
      else _lbScale = 2.5;
      img.style.transform = `scale(${_lbScale}) translate(${_lbTranslate.x}px, ${_lbTranslate.y}px)`;
    }
    lastTap = now;
    isDragging = false;
  }, { passive: true });
}

function openVideoModal(videoUrl){
  const modal = $('#videoModal');
  const player = $('#videoModalPlayer');
  player.src = videoUrl;
  modal.classList.add('show');
  document.body.classList.add('no-scroll');
  player.play().catch(()=>{});
}
window.openVideoModal = openVideoModal;

function closeVideoModal(){
  const modal = $('#videoModal');
  const player = $('#videoModalPlayer');
  player.pause();
  player.src = '';
  modal.classList.remove('show');
  document.body.classList.remove('no-scroll');
}
window.closeVideoModal = closeVideoModal;

function openVideoOrImageModal(type, url){
  if (type === 'video') openVideoModal(url);
  else {
    const lb = $('#lightbox');
    const img = $('#lightboxImg');
    img.src = fixImgUrl(url);
    img.style.transform = 'scale(1) translate(0,0)';
    _lbScale = 1;
    lb.classList.add('show');
    document.body.classList.add('no-scroll');
  }
}
window.openVideoOrImageModal = openVideoOrImageModal;

/* ==========================================================================
   📝 REVIEWS
   ========================================================================== */
function startReviewListener(productId){
  if (reviewListener){ try { reviewListener(); } catch(e){} reviewListener = null; }
  if (!db) return;
  if (reviewRetryCount > 3) return;
  try {
    reviewListener = db.collection('products').doc(productId).collection('reviews')
      .orderBy('createdAtMs', 'desc').limit(100)
      .onSnapshot(snap => {
        reviewRetryCount = 0;
        currentProductReviews = [];
        snap.forEach(d => {
          const data = d.data();
          currentProductReviews.push({ id: d.id, ...data });
        });
        const current = parseHash().parts[0];
        const currentId = parseHash().parts[1];
        if (current === 'product' && currentId === productId){
          renderProductReviewsOnly(productId);
        }
      }, err => {
        reviewRetryCount++;
        if (reviewRetryCount <= 3){
          setTimeout(() => loadProductReviewsRealtime(productId), 2000);
        }
      });
  } catch(e){}
}

async function loadProductReviewsRealtime(productId){
  if (!db) return;
  try {
    const snap = await db.collection('products').doc(productId).collection('reviews').limit(100).get();
    currentProductReviews = [];
    snap.forEach(d => currentProductReviews.push({ id: d.id, ...d.data() }));
    currentProductReviews.sort((a,b) => (b.createdAtMs || 0) - (a.createdAtMs || 0));
    renderProductReviewsOnly(productId);
    startReviewListener(productId);
  } catch(e){
    reviewRetryCount++;
    if (reviewRetryCount <= 3) startReviewListener(productId);
  }
}

function renderProductReviewsOnly(productId){
  const box = document.getElementById('reviewsListInner');
  if (!box) return;
  const avg = currentProductReviews.length
    ? currentProductReviews.reduce((s,r) => s + (r.rating||0), 0) / currentProductReviews.length
    : 0;
  const rbNum = document.querySelector('.rb-num');
  if (rbNum) rbNum.textContent = bn(avg.toFixed(1));
  const rbTotal = document.querySelector('.rb-total');
  if (rbTotal) rbTotal.textContent = bn(currentProductReviews.length) + ' রেটিং';

  const bars = document.querySelectorAll('.rate-bars .rb-row');
  bars.forEach((row, i) => {
    const star = 5 - i;
    const count = currentProductReviews.filter(r => Math.round(r.rating) === star).length;
    const pct = currentProductReviews.length ? Math.round(count / currentProductReviews.length * 100) : 0;
    const track = row.querySelector('.rb-track i');
    const pctEl = row.querySelector('.rb-pct');
    if (track) track.style.width = pct + '%';
    if (pctEl) pctEl.textContent = bn(pct) + '%';
  });

  box.innerHTML = currentProductReviews.length 
    ? currentProductReviews.slice(0,5).map(r => renderReviewItem(r)).join('') 
    : `<div style="text-align:center;padding:22px 0;color:var(--muted);font-size:13.5px">এখনো কোনো রিভিউ নেই</div>`;
}

let _reviewImages = [];
let _reviewVideoUrl = '';
let _reviewVideoFile = null;

function openReviewSheet(productId){
  if (!canUserReviewProduct(productId)){
    toast('❌ রিভিউ দিতে হলে পণ্যটি অর্ডার করে ডেলিভারি নিতে হবে', 'err');
    return;
  }
  if (S.reviewedProducts.includes(productId)){
    toast('✅ আপনি ইতিমধ্যে এই পণ্যে রিভিউ দিয়েছেন', 'info');
    return;
  }
  _reviewImages = [];
  _reviewVideoUrl = '';
  _reviewVideoFile = null;

  const videoSection = isVideoReviewEnabled() ? `
    <div class="field">
      <label>🎬 ভিডিও রিভিউ (সর্বোচ্চ ১ মিনিট)</label>
      <div style="border:2px dashed var(--border);border-radius:12px;padding:14px;text-align:center;background:var(--surface-2)">
        <input type="file" id="revVideoInput" accept="video/*" style="display:none" onchange="handleReviewVideo(event)">
        <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('revVideoInput').click()">${ICO.video} ভিডিও আপলোড করুন</button>
        <div style="font-size:11px;color:var(--muted);margin-top:6px">ভয়েসসহ সর্বোচ্চ ১ মিনিটের ভিডিও</div>
        <div class="progress" id="revVidProg" style="display:none;margin-top:8px"><div class="bar" id="revVidBar" style="height:6px;background:var(--primary);border-radius:99px;width:0;transition:width .22s"></div></div>
        <div id="revVideoPreview" style="margin-top:8px"></div>
      </div>
    </div>
  ` : '';

  const body = `
    <div class="field"><label>আপনার রেটিং</label>
      <div class="star-pick" id="starPick">${[1,2,3,4,5].map(i=>`<i class="on" data-v="${i}" onclick="setRevStar(${i})">★</i>`).join('')}</div>
    </div>
    <div class="field"><label>আপনার নাম</label><input class="input" id="revName" placeholder="নাম" value="${escAttr(S.user?.displayName||'')}"></div>
    <div class="field"><label>আপনার মতামত</label><textarea class="textarea" id="revText" placeholder="অভিজ্ঞতা লিখুন..."></textarea></div>

    <div class="field">
      <label>📷 ছবি যোগ করুন (সর্বোচ্চ ৩টি)</label>
      <div class="img-upload-grid" id="revImgGrid">
        <div class="img-upload-slot" onclick="document.getElementById('revImgInput').click()">
          ${ICO.camera}<span>ছবি যোগ</span>
        </div>
      </div>
      <input type="file" id="revImgInput" accept="image/*" multiple style="display:none" onchange="handleReviewImages(event)">
    </div>

    ${videoSection}
  `;
  const foot = `<button class="btn btn-primary btn-block" id="revSubmitBtn" data-id="${escAttr(productId)}" onclick="submitReview(this.dataset.id, event)">রিভিউ সাবমিট</button>`;
  openSheet('রিভিউ লিখুন', body, foot);
  _revStar = 5;
}
window.openReviewSheet = openReviewSheet;

function setRevStar(v){
  _revStar = v;
  $$('#starPick i').forEach(el => el.classList.toggle('on', Number(el.dataset.v) <= v));
}
window.setRevStar = setRevStar;

function compressImage(dataUrl, maxSize, quality){
  return new Promise(resolve => {
    const img = new Image();
    img.onload = function(){
      let w = img.width, h = img.height;
      if (w > h){ if (w > maxSize){ h = Math.round(h * maxSize / w); w = maxSize; } }
      else { if (h > maxSize){ w = Math.round(w * maxSize / h); h = maxSize; } }
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      resolve(canvas.toDataURL('image/jpeg', quality));
    };
    img.onerror = () => resolve(dataUrl);
    img.src = dataUrl;
  });
}

async function handleReviewImages(ev){
  const files = ev.target.files;
  if (!files) return;
  const remaining = 3 - _reviewImages.length;
  const toAdd = Math.min(files.length, remaining);
  for (let i=0; i<toAdd; i++){
    const file = files[i];
    if (!file.type.startsWith('image/')) continue;
    try {
      const url = await FB.uploadToCloudinary(file, 'image');
      _reviewImages.push(url);
      renderReviewImageGrid();
    } catch(e){
      toast('ছবি আপলোড ব্যর্থ', 'err');
    }
  }
  ev.target.value = '';
}
window.handleReviewImages = handleReviewImages;

function renderReviewImageGrid(){
  const grid = $('#revImgGrid');
  if (!grid) return;
  grid.innerHTML = _reviewImages.map((url, i) => `
    <div class="img-upload-slot" style="border-style:solid">
      <img src="${url}" alt="review img">
      <button type="button" class="remove-img" onclick="removeReviewImage(${i})">×</button>
    </div>
  `).join('') + (_reviewImages.length < 3 ? `
    <div class="img-upload-slot" onclick="document.getElementById('revImgInput').click()">
      ${ICO.camera}<span>ছবি যোগ</span>
    </div>
  ` : '');
}

function removeReviewImage(idx){
  _reviewImages.splice(idx, 1);
  renderReviewImageGrid();
}
window.removeReviewImage = removeReviewImage;

async function handleReviewVideo(ev){
  const file = ev.target.files && ev.target.files[0];
  if (!file) return;
  if (!file.type.startsWith('video/')){ toast('শুধু ভিডিও ফাইল সিলেক্ট করুন', 'err'); return; }
  
  const video = document.createElement('video');
  video.preload = 'metadata';
  video.onloadedmetadata = async function(){
    URL.revokeObjectURL(video.src);
    if (video.duration > 65){
      toast('⚠️ ভিডিও সর্বোচ্চ ১ মিনিট হতে হবে', 'err');
      return;
    }
    if (file.size > 50 * 1024 * 1024){
      toast('⚠️ ভিডিও ৫০MB এর কম হতে হবে', 'err');
      return;
    }
    const progBox = $('#revVidProg');
    const progBar = $('#revVidBar');
    if (progBox) progBox.style.display = 'block';
    try {
      const url = await FB.uploadToCloudinary(file, 'video', (pct) => {
        if (progBar) progBar.style.width = pct + '%';
      });
      _reviewVideoUrl = url;
      const preview = $('#revVideoPreview');
      if (preview){
        preview.innerHTML = `
          <video src="${url}" controls playsinline style="max-width:100%;max-height:160px;border-radius:8px"></video>
          <button type="button" class="btn btn-sm btn-ghost" style="margin-top:6px" onclick="removeReviewVideo()">${ICO.trash} ভিডিও সরান</button>
        `;
      }
      toast('✓ ভিডিও আপলোড সম্পন্ন', 'ok');
    } catch(e){
      toast('ভিডিও আপলোড ব্যর্থ: ' + e.message, 'err');
    }
    if (progBox) progBox.style.display = 'none';
  };
  video.src = URL.createObjectURL(file);
}
window.handleReviewVideo = handleReviewVideo;

function removeReviewVideo(){
  _reviewVideoUrl = '';
  const preview = $('#revVideoPreview');
  if (preview) preview.innerHTML = '';
  const inp = $('#revVideoInput');
  if (inp) inp.value = '';
  const progBox = $('#revVidProg');
  if (progBox) progBox.style.display = 'none';
}
window.removeReviewVideo = removeReviewVideo;

async function submitReview(productId, ev){
  if (!canUserReviewProduct(productId)){
    toast('❌ রিভিউ দেওয়ার অনুমতি নেই', 'err');
    return;
  }
  const name = $('#revName').value.trim() || 'গ্রাহক';
  const text = $('#revText').value.trim();
  if (text.length < 5){ toast('অন্তত ৫ অক্ষরের রিভিউ লিখুন', 'err'); return; }
  const btn = (ev && ev.target) ? ev.target : document.getElementById('revSubmitBtn');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ পাঠানো হচ্ছে...'; }

  const review = {
    user: name,
    rating: _revStar || 5,
    text,
    date: new Date().toLocaleDateString('bn-BD', { day:'numeric', month:'long', year:'numeric' }),
    verified: true,
    userId: S.user?.uid || 'guest',
    images: _reviewImages.slice(0, 3),
    videoUrl: _reviewVideoUrl || '',
    productId
  };
  const res = await FB.addReview(productId, review);
  if (!res.ok){
    toast('❌ রিভিউ সেভ হয়নি: ' + (res.error || 'Unknown error'), 'err');
    if (btn){ btn.disabled = false; btn.textContent = 'রিভিউ সাবমিট'; }
    return;
  }
  if (!S.reviews[productId]) S.reviews[productId] = [];
  S.reviews[productId].unshift(review);
  if (!S.reviewedProducts.includes(productId)) S.reviewedProducts.push(productId);
  save();
  closeSheet();
  toast('✅ রিভিউ সাবমিট হয়েছে — ধন্যবাদ!', 'ok');
  setTimeout(() => {
    const current = parseHash().parts[0];
    const currentId = parseHash().parts[1];
    if (current === 'product' && currentId === productId){
      loadProductReviewsRealtime(productId);
    }
  }, 1200);
}
window.submitReview = submitReview;

/* ==========================================================================
   Q&A
   ========================================================================== */
async function loadProductQuestions(productId){
  if (!db) return;
  try {
    const arr = await FB.loadProductQuestions(productId);
    currentProductQuestions = arr;
    renderProductQuestionsOnly(productId);
    startQuestionsListener(productId);
  } catch(e){ currentProductQuestions = []; }
}
function startQuestionsListener(productId){
  if (questionsListener){ try { questionsListener(); } catch(e){} questionsListener = null; }
  if (!db || !isProductQuestionLive()) return;
  try {
    questionsListener = db.collection('products').doc(productId).collection('questions')
      .orderBy('createdAtMs', 'desc').limit(50)
      .onSnapshot(snap => {
        currentProductQuestions = [];
        snap.forEach(d => currentProductQuestions.push({ id: d.id, ...d.data() }));
        const current = parseHash().parts[0];
        const currentId = parseHash().parts[1];
        if (current === 'product' && currentId === productId){
          renderProductQuestionsOnly(productId);
        }
      }, err => console.warn('[Q&A] listener error:', err));
  } catch(e){}
}
function renderProductQuestionsOnly(productId){
  const box = document.getElementById('qaListInner');
  if (!box) return;
  const list = currentProductQuestions;
  box.innerHTML = list.length ? list.slice(0,3).map(q => `
    <div class="qa-item">
      <div class="qa-q"><span class="qa-badge">প্রশ্ন</span><span>${esc(q.question)}</span></div>
      ${(q.answers && q.answers.length) ? q.answers.slice(0,1).map(a => `
        <div class="qa-a"><span class="qa-badge" style="background:#dcfce7;color:#15803d">উত্তর</span><span>${esc(a.text)}</span></div>
        <div class="qa-meta">— ${esc(a.by || 'Must Look')} · ${esc(a.date || '')}</div>
      `).join('') : `<div class="qa-a" style="color:var(--muted);font-style:italic"><span class="qa-badge" style="background:#fef3c7;color:#92400e">অপেক্ষমাণ</span><span>উত্তরের অপেক্ষায়</span></div>`}
    </div>
  `).join('') : `<div style="text-align:center;padding:22px 0;color:var(--muted);font-size:13.5px">এখনো কোনো প্রশ্ন নেই — প্রথম প্রশ্নটি করুন</div>`;
}
function openQuestionSheet(productId){
  const body = `
    <div class="field">
      <label>আপনার নাম (ঐচ্ছিক)</label>
      <input class="input" id="qaName" placeholder="নাম" value="${escAttr(S.user?.displayName || '')}">
    </div>
    <div class="field">
      <label>আপনার প্রশ্ন <span class="req">*</span></label>
      <textarea class="textarea" id="qaText" placeholder="পণ্য সম্পর্কে আপনার প্রশ্ন লিখুন..." rows="4"></textarea>
    </div>
  `;
  const foot = `<button class="btn btn-primary btn-block" id="qaSubmitBtn" data-id="${escAttr(productId)}" onclick="submitQuestion(this.dataset.id, event)">প্রশ্ন পাঠান</button>`;
  openSheet('প্রশ্ন করুন', body, foot);
}
window.openQuestionSheet = openQuestionSheet;

async function submitQuestion(productId, ev){
  const name = ($('#qaName')?.value || '').trim() || 'গ্রাহক';
  const text = ($('#qaText')?.value || '').trim();
  if (text.length < 5){ toast('অন্তত ৫ অক্ষরের প্রশ্ন লিখুন', 'err'); return; }
  const btn = (ev && ev.target) ? ev.target : document.getElementById('qaSubmitBtn');
  if (btn){ btn.disabled = true; btn.textContent = '⏳ পাঠানো হচ্ছে...'; }

  const question = {
    question: text,
    user: name,
    userId: S.user?.uid || 'guest',
    date: new Date().toLocaleDateString('bn-BD', { day:'numeric', month:'long', year:'numeric' })
  };
  try {
    await FB.addProductQuestion(productId, question);
    toast('✓ প্রশ্ন পাঠানো হয়েছে', 'ok');
    closeSheet();
    setTimeout(() => loadProductQuestions(productId), 600);
  } catch(e){
    toast('প্রশ্ন পাঠানো যায়নি', 'err');
    if (btn){ btn.disabled = false; btn.textContent = 'প্রশ্ন পাঠান'; }
  }
}
window.submitQuestion = submitQuestion;

