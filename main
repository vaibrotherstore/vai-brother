const $ = (s, r=document) => r.querySelector(s);
const $$ = (s, r=document) => Array.from(r.querySelectorAll(s));
const esc = s => (s == null ? '' : String(s)).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const escAttr = esc;
const money = n => {
  try { return CONFIG.store.currency + Number(n||0).toLocaleString('bn-BD', { maximumFractionDigits:0 }); }
  catch(e){ return CONFIG.store.currency + Number(n||0).toLocaleString('en-IN', { maximumFractionDigits:0 }); }
};
const bn = n => {
  try { return Number(n||0).toLocaleString('bn-BD', { maximumFractionDigits:0 }); }
  catch(e){ return Number(n||0).toLocaleString('en-IN', { maximumFractionDigits:0 }); }
};

function go(path){
  const currentHash = location.hash || '#/home';
  const targetHash = '#' + path;
  if (currentHash !== targetHash){
    saveScrollPosition(currentHash, window.scrollY || window.pageYOffset || 0);
  }
  if (location.hash === targetHash) render();
  else location.hash = targetHash;
}
window.go = go;

function toast(msg, type=''){
  const wrap = $('#toastWrap');
  if (!wrap) return;
  while (wrap.children.length >= 3) wrap.firstChild.remove();
  const el = document.createElement('div');
  el.className = 'toast ' + type;
  el.setAttribute('role', 'alert');
  const ico = type==='ok' ? ICO.check : type==='err' ? ICO.info : ICO.info;
  el.innerHTML = `<span>${ico}</span><span>${esc(msg)}</span>`;
  wrap.appendChild(el);
  setTimeout(()=>{ el.classList.add('out'); setTimeout(()=>el.remove(),300); }, 2600);
}
window.toast = toast;

function openSheet(title, body, foot=''){
  $('#sheetTitle').textContent = title;
  $('#sheetBody').innerHTML = body;
  const f = $('#sheetFoot');
  if (foot){ f.innerHTML = foot; f.classList.remove('hide'); } else { f.innerHTML = ''; f.classList.add('hide'); }
  $('#sheet').classList.add('show');
  $('#overlay').classList.add('show');
  document.body.classList.add('no-scroll');
}
function closeSheet(){
  $('#sheet').classList.remove('show');
  if (!$('#drawer').classList.contains('show')){
    $('#overlay').classList.remove('show');
    document.body.classList.remove('no-scroll');
  }
}
function openDrawer(){
  renderDrawer();
  $('#drawer').classList.add('show');
  $('#overlay').classList.add('show');
  document.body.classList.add('no-scroll');
}
function closeAll(){
  $('#drawer').classList.remove('show');
  $('#sheet').classList.remove('show');
  $('#overlay').classList.remove('show');
  document.body.classList.remove('no-scroll');
}
window.openSheet = openSheet; window.closeSheet = closeSheet;
window.openDrawer = openDrawer; window.closeAll = closeAll;

function imgFor(p, idx=0, w=500){
  const imgs = getProductImages(p);
  const url = imgs[idx] || imgs[0];
  if (url) return fixImgUrl(url);
  const palettes = [['#e8e8e8','#c0c0c0'],['#dcdcdc','#a8a8a8'],['#e5e5e5','#b8b8b8'],['#efefef','#c8c8c8']];
  let h = 0; const s = String(p.id||'x');
  for (let i=0;i<s.length;i++) h = (h*31 + s.charCodeAt(i))>>>0;
  const c = palettes[h % palettes.length];
  const safeEmoji = String(p.emoji||'🛍️').replace(/[<>&"']/g, '').slice(0, 8);
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${c[0]}"/><stop offset="1" stop-color="${c[1]}"/></linearGradient></defs><rect width="400" height="400" fill="url(#g)"/><text x="200" y="215" font-size="130" text-anchor="middle" dominant-baseline="middle">${safeEmoji}</text></svg>`;
  return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
}
window.imgFor = imgFor;

function getProduct(id){ return ALL_PRODUCTS.find(p => p.id === id); }
function getCategory(id){
  if (!id) return null;
  const key = String(id).toLowerCase();
  return ALL_CATEGORIES.find(c =>
    c.id === id || c.name === id ||
    (c.id && String(c.id).toLowerCase() === key) ||
    (c.name && c.name.toLowerCase() === key)
  );
}
function fixImgUrl(url){ return url ? String(url).trim() : url; }
function getProductImage(p){
  if (!p) return null;
  if (p.images && p.images.length) return fixImgUrl(p.images[0]);
  if (p.image) return fixImgUrl(p.image);
  return null;
}
function getProductImages(p){
  if (!p) return [];
  if (Array.isArray(p.images) && p.images.length) return p.images.map(fixImgUrl);
  if (typeof p.images === 'string' && p.images.trim()) return p.images.split(',').map(s => fixImgUrl(s.trim()));
  if (p.image) return [fixImgUrl(p.image)];
  return [];
}
function getProductVideo(p){
  if (!p) return null;
  if (p.video && typeof p.video === 'string') return String(p.video).trim();
  if (Array.isArray(p.videos) && p.videos.length) return String(p.videos[0]).trim();
  return null;
}

