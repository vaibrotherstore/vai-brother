function openProfilePicSheet(){
  if (!S.user){ toast('প্রথমে লগইন করুন', 'err'); openAuthSheet('login'); return; }
  const body = `
    <div style="text-align:center;padding:14px 0">
      <div style="width:130px;height:130px;border-radius:50%;margin:0 auto 16px;overflow:hidden;background:var(--surface-2);border:3px solid var(--primary);display:grid;place-items:center;font-size:44px;color:var(--muted)" id="picPreview">
        ${S.profilePic ? `<img src="${S.profilePic}" style="width:100%;height:100%;object-fit:cover">` : ICO.user}
      </div>
      <input type="file" id="profilePicInput" accept="image/*" style="display:none" onchange="handleProfilePicSelect(event)">
      <button class="btn btn-primary btn-block" onclick="document.getElementById('profilePicInput').click()">
        ${ICO.camera} ছবি সিলেক্ট করুন
      </button>
      ${S.profilePic ? `<button class="btn btn-ghost btn-block" style="margin-top:10px;color:var(--danger)" onclick="removeProfilePic()">ছবি সরান</button>` : ''}
    </div>`;
  openSheet('প্রোফাইল ছবি', body);
}
window.openProfilePicSheet = openProfilePicSheet;

async function handleProfilePicSelect(ev){
  const file = ev.target.files && ev.target.files[0];
  if (!file) return;
  if (!file.type.startsWith('image/')){ toast('শুধু ইমেজ ফাইল সিলেক্ট করুন', 'err'); return; }
  try {
    const url = await FB.uploadToCloudinary(file, 'image');
    S.profilePic = url;
    save();
    const prev = $('#picPreview');
    if (prev) prev.innerHTML = `<img src="${url}" style="width:100%;height:100%;object-fit:cover">`;
    persistProfilePic(url);
    toast('ছবি সফলভাবে আপলোড হয়েছে ✅', 'ok');
    setTimeout(()=>{ closeSheet(); render(); renderDrawer(); }, 800);
  } catch(e){
    toast('ছবি আপলোড ব্যর্থ', 'err');
  }
}
window.handleProfilePicSelect = handleProfilePicSelect;

async function persistProfilePic(dataUrl){
  try {
    if (db && S.user?.uid){
      await db.collection('users').doc(S.user.uid).set({ photoURL: dataUrl, updatedAt: Date.now() }, { merge: true });
    }
  } catch(e){ console.warn('Persist profile pic failed:', e); }
}

function removeProfilePic(){
  S.profilePic = null;
  save();
  const prev = $('#picPreview');
  if (prev) prev.innerHTML = ICO.user;
  toast('ছবি সরানো হয়েছে');
  setTimeout(()=>{ closeSheet(); render(); renderDrawer(); }, 500);
}
window.removeProfilePic = removeProfilePic;

