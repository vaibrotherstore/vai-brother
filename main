            </div>
            <div style="font-weight:700;font-size:13.5px;color:var(--primary)">${money(p.price * item.qty)}</div>
          </div>`;
        }).join('')}
      </div>

      <div class="card card-pad" style="margin-top:12px">
        <div class="summary-row"><span>সাবটোটাল</span><span class="val">${money(cartSubtotal())}</span></div>
        ${discountAmount() > 0 ? `<div class="summary-row"><span>ছাড়</span><span class="val" style="color:var(--success)">− ${money(discountAmount())}</span></div>` : ''}
        <div class="summary-row"><span>ডেলিভারি</span><span class="val">${dcText}</span></div>
        <div class="summary-row total"><span>সর্বমোট</span><span class="val">${money(cartTotal())}</span></div>
        ${!isLocalAddr ? `<div style="font-size:12.5px;color:#78350f;margin-top:8px;padding:10px 12px;background:#fffbeb;border:1px solid #fde68a;border-radius:9px;line-height:1.6">
