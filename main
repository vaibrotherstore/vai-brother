  </div>`;
}

/* ==========================================================================
   💬 CHAT
   ========================================================================== */
function getChatPhone(){
  if (S.chatPhone) return S.chatPhone;
  const validAddr = S.addresses.find(a => a && a.phone);
  if (validAddr && validAddr.phone) return validAddr.phone;
  if (S.orders.length && S.orders[0].phone) return S.orders[0].phone;
  if (S.checkout.guestPhone) return S.checkout.guestPhone;
  const persisted = getPersistentGuestPhone();
  if (persisted) return persisted;
  return null;
}

function renderChatPage(){
  const phone = getChatPhone();
  if (!phone){
    return `
    <div style="padding:14px 2px 12px">
      <button class="icon-btn" style="width:36px;height:36px;display:inline-grid" onclick="history.back()">${ICO.arrowL}</button>
      <h1 style="font-size:18px;font-weight:700;margin-top:10px">💬 লাইভ চ্যাট</h1>
    </div>
    <div class="empty-state">
      <div class="es-ico">${ICO.chat}</div>
      <h3>চ্যাট করার জন্য ফোন নম্বর প্রয়োজন</h3>
      <p>অ্যাডমিনের সাথে চ্যাট করতে আপনার ফোন নম্বর দরকার।</p>
      <button class="btn btn-primary" onclick="openChatPhoneSheet()">📞 ফোন নম্বর যোগ করুন</button>
    </div>`;
  }
  return `
  <div style="display:flex;align-items:center;gap:10px;padding:14px 2px 12px">
    <button class="icon-btn" style="width:36px;height:36px;flex:0 0 36px" onclick="history.back()">${ICO.arrowL}</button>
    <h1 style="font-size:17px;font-weight:700">💬 লাইভ চ্যাট</h1>
    <span class="chat-status-pill online" style="margin-left:auto">● অনলাইন সাপোর্ট</span>
  </div>
  <div class="chat-wrap">
    <div class="chat-msgs" id="chatMsgs">
      <div style="text-align:center;color:var(--muted);padding:30px;font-size:13px">লোড হচ্ছে...</div>
    </div>
    <div class="chat-input-row">
      <textarea id="chatInput" placeholder="আপনার মেসেজ লিখুন..." rows="1"></textarea>
      <button class="chat-send-btn" onclick="sendChat()">${ICO.send}</button>
    </div>
  </div>
  <div style="height:16px"></div>`;
}
window.renderChatPage = renderChatPage;

function openChatPhoneSheet(){
  const body = `
    <div class="field">
      <label>আপনার ফোন নম্বর <span class="req">*</span></label>
      <input class="input" id="chatPhoneInput" type="tel" placeholder="01XXXXXXXXX" maxlength="11">
    </div>`;
  const foot = `<button class="btn btn-primary btn-block" onclick="saveChatPhone()">চ্যাট শুরু করুন</button>`;
  openSheet('ফোন নম্বর যোগ করুন', body, foot);
}
window.openChatPhoneSheet = openChatPhoneSheet;

function saveChatPhone(){
  const phone = ($('#chatPhoneInput')?.value || '').trim();
  if (!/^01[3-9]\d{8}$/.test(phone)){ toast('সঠিক ১১ ডিজিটের নম্বর দিন', 'err'); return; }
  S.chatPhone = phone;
  setPersistentGuestPhone(phone);
  save();
  closeSheet();
  go('/chat');
  toast('চ্যাট শুরু হয়েছে', 'ok');
}
window.saveChatPhone = saveChatPhone;

function afterChatPage(){
  const phone = getChatPhone();
  if (!phone) return;
  const ta = $('#chatInput');
  if (ta){
    ta.addEventListener('input', () => {
      ta.style.height = 'auto';
      ta.style.height = Math.min(ta.scrollHeight, 100) + 'px';
    });
    ta.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); sendChat(); }
    });
  }
  startChatListener(phone);
}

function startChatListener(phone){
  if (chatListener){ try { chatListener(); } catch(e){} chatListener = null; }
  if (!db) return;
  try {
    chatListener = db.collection('chats').doc(phone).collection('messages')
      .orderBy('createdAt', 'asc').limit(200)
      .onSnapshot(snap => {
        const box = $('#chatMsgs');
        if (!box) return;
        const msgs = [];
        snap.forEach(d => msgs.push({ id: d.id, ...d.data() }));
        if (msgs.length === 0){
          box.innerHTML = `<div style="text-align:center;color:var(--muted);padding:30px;font-size:13px">👋 আসসালামু আলাইকুম!<br>আমাদের সাথে চ্যাট শুরু করুন।</div>`;
          return;
        }
        const currentInput = document.getElementById('chatInput');
        const curVal = currentInput ? currentInput.value : '';
        box.innerHTML = msgs.map(m => {
          const t = m.createdAt ? new Date(m.createdAt).toLocaleString('bn-BD', {day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '';
          if (m.system) return `<div class="chat-bubble system">${esc(m.text)}<small>${t}</small></div>`;
          const side = m.from === 'customer' ? 'me' : 'them';
          return `<div class="chat-bubble ${side}">${esc(m.text)}<small>${m.from === 'customer' ? 'আপনি' : 'সাপোর্ট'} · ${t}</small></div>`;
        }).join('');
        box.scrollTop = box.scrollHeight;
        if (currentInput && currentInput.value !== curVal) currentInput.value = curVal;
      }, err => console.warn('[Chat] listener error:', err));
  } catch(e){ console.warn('[Chat] start error:', e); }
}

async function sendChat(){
  const phone = getChatPhone();
  if (!phone){ toast('ফোন নম্বর যোগ করুন', 'err'); openChatPhoneSheet(); return; }
  const ta = $('#chatInput');
  if (!ta) return;
  const text = ta.value.trim();
  if (!text) return;
  ta.value = '';
  ta.style.height = 'auto';
  try {
    const chatRef = db.collection('chats').doc(phone);
    await chatRef.collection('messages').add({ text, from: 'customer', createdAt: Date.now() });
    await chatRef.set({
      customerName: S.user?.displayName || S.addresses[0]?.name || S.checkout.guestName || 'কাস্টমার',
      customerEmail: S.user?.email || '',
      phone,
      lastMessage: text,
      lastMessageAt: Date.now(),
      lastMessageFrom: 'customer',
      unreadByAdmin: firebase.firestore.FieldValue.increment(1),
      updatedAt: Date.now()
    }, { merge: true });
  } catch(e){ toast('মেসেজ পাঠানো যায়নি', 'err'); }
}
window.sendChat = sendChat;

